// Copy to Secrets.local.xcconfig (untracked) to bundle local build-time keys:
//
//   cp Configurations/Secrets.local.example.xcconfig \
//      Configurations/Secrets.local.xcconfig
//
// Leave absent for public builds without bundled keys.

// Built-in WeTrakr OAuth Client ID (optional; users can still enter their own in Settings).
// WETRAKR_CLIENT_ID = your_wetrakr_client_id
