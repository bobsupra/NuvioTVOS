+#if HAVE_THREADS
+static int vc1_update_thread_context(AVCodecContext *dst,
+                                     const AVCodecContext *src)
+{
+    VC1Context *const v              = dst->priv_data;
+    const VC1Context *const v1       = src->priv_data;
+    MpegEncContext *const s          = &v->s;
+    const MpegEncContext *const s1   = &v1->s;
+    int ret;
+
+    if (dst == src)
+        return 0;
+
+    /* Only state the source no longer changes is read here: the source may
+     * still be decoding (see ff_thread_finish_setup() in vc1_decode_frame()).
+     * After setup, a B picture's second field header, its blocks and the
+     * doubled field linesize keep changing its context, and so do the blocks
+     * of a frame or interlaced frame reference picture. */
+
+    /* sequence header and entry point */
+    memcpy(&v->res_sprite, &v1->res_sprite,
+           (const char *)&v1->finterpflag + sizeof(v1->finterpflag) -
+           (const char *)&v1->res_sprite);
+    v->zz_8x4                = v1->zz_8x4;
+    v->zz_4x8                = v1->zz_4x8;
+    v->hrd_num_leaky_buckets = v1->hrd_num_leaky_buckets;
+    v->resync_marker         = v1->resync_marker;
+    v->broken_link           = v1->broken_link;
+    v->closed_entry          = v1->closed_entry;
+    v->range_mapy_flag       = v1->range_mapy_flag;
+    v->range_mapuv_flag      = v1->range_mapuv_flag;
+    v->range_mapy            = v1->range_mapy;
+    v->range_mapuv           = v1->range_mapuv;
+
+    /* the source dropped its context, with its reference pictures */
+    if (!s1->context_initialized) {
+        if (s->context_initialized)
+            vc1_decode_reset(dst);
+        return 0;
+    }
+
+    if (s->context_initialized &&
+        (s->width != s1->width || s->height != s1->height))
+        vc1_decode_reset(dst);
+    if (!s->context_initialized) {
+        ret = vc1_init_context(dst, 0);
+        if (ret < 0)
+            return ret;
+    }
+    s->h_edge_pos      = s1->h_edge_pos;
+    s->v_edge_pos      = s1->v_edge_pos;
+    s->low_delay       = s1->low_delay;
+    s->workaround_bugs = s1->workaround_bugs;
+
+    ff_mpv_replace_picture(&s->last_pic, &s1->last_pic);
+    ff_mpv_replace_picture(&s->next_pic, &s1->next_pic);
+
+    /* carried from picture to picture */
+    if (v1->profile < PROFILE_ADVANCED) // Advanced codes it in every header
+        v->rnd = v1->rnd;
+    v->refdist     = v1->refdist;       // a B field picture reads its anchor's
+    v->last_use_ic = v1->last_use_ic;
+    v->next_use_ic = v1->next_use_ic;
+    v->aux_use_ic  = v1->aux_use_ic;
+    memcpy(v->last_luty,  v1->last_luty,  sizeof(v->last_luty));
+    memcpy(v->last_lutuv, v1->last_lutuv, sizeof(v->last_lutuv));
+    memcpy(v->aux_luty,   v1->aux_luty,   sizeof(v->aux_luty));
+    memcpy(v->aux_lutuv,  v1->aux_lutuv,  sizeof(v->aux_lutuv));
+    memcpy(v->next_luty,  v1->next_luty,  sizeof(v->next_luty));
+    memcpy(v->next_lutuv, v1->next_lutuv, sizeof(v->next_lutuv));
+    v->curr_use_ic = !v1->curr_use_ic ? NULL :
+                     v1->curr_use_ic == &v1->aux_use_ic ? &v->aux_use_ic : &v->next_use_ic;
+    v->curr_luty   = !v1->curr_luty ? NULL :
+                     v1->curr_luty == v1->aux_luty ? v->aux_luty : v->next_luty;
+    v->curr_lutuv  = !v1->curr_lutuv ? NULL :
+                     v1->curr_lutuv == v1->aux_lutuv ? v->aux_lutuv : v->next_lutuv;
+
+    /* field flags of the last reference field picture (B field direct mode) */
+    av_refstruct_replace(&v->mv_f_next_ref, v1->mv_f_next_ref);
+    v->mv_f_next[0] = (v->mv_f_next_ref ? v->mv_f_next_ref : v->mv_f_next_base) +
+                      s->b8_stride + 1;
+
+    return 0;
