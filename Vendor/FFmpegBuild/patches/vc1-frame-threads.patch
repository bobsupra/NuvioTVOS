diff --git a/libavcodec/vc1.h b/libavcodec/vc1.h
index f2a52c1..fcf83e6 100644
--- a/libavcodec/vc1.h
+++ b/libavcodec/vc1.h
@@ -27,6 +27,7 @@
 #include "get_bits.h"
 #include "h264chroma.h"
 #include "mpegvideo.h"
+#include "threadprogress.h"
 #include "intrax8.h"
 #include "vc1_common.h"
 #include "vc1dsp.h"
@@ -353,6 +354,14 @@ typedef struct VC1Context{
     uint8_t *blk_mv_type_base, *blk_mv_type;    ///< 0: frame MV, 1: field MV (interlaced frame)
     uint8_t *mv_f_base, *mv_f[2];               ///< 0: MV obtained from same field, 1: opposite field
     uint8_t *mv_f_next_base, *mv_f_next[2];
+    size_t mv_f_size;       ///< bytes in each of mv_f_base and mv_f_next_base
+    /**
+     * Field flags of reference field pictures. Each one writes mv_f[0] into a
+     * buffer of its own, which B field pictures then read as mv_f_next[0],
+     * so a later frame thread can read it while it is still being written.
+     */
+    struct AVRefStructPool *mv_f_pool;
+    uint8_t *mv_f_next_ref;     ///< RefStruct reference: the buffer mv_f_next[0] points into, if any
     int field_mode;         ///< 1 for interlaced field pictures
     int fptype;
     int second_field;
@@ -440,4 +449,55 @@ void ff_vc1_mc_4mv_chroma4(VC1Context *v, int dir, int dir2, int avg);
 
 void ff_vc1_interp_mc(VC1Context *v);
 
+/**
+ * Frame threading. A reference picture reports its progress in macroblock
+ * rows of the frame (16 luma lines); a picture that reads it waits for the
+ * rows it is about to touch. A field picture reports while it decodes its
+ * second field, when the rows of both fields are there.
+ */
+
+/**
+ * Rows behind the row being decoded that a picture still changes: its pixels
+ * are put one row behind, once the overlap filter has run, and the loop
+ * filter runs behind that. In a field picture these are field rows.
+ */
+#define VC1_PROGRESS_LAG 3
+
+/** Report the rows the macroblock row just decoded has made final. */
+static av_always_inline void ff_vc1_report_row(const VC1Context *v)
+{
+    const MpegEncContext *s = &v->s;
+
+    int row;
+
+    /* Error concealment rewrites the picture at its end, so a damaged
+     * picture is only reported then, as in the H.263 decoder. */
+    if (!s->cur_pic.reference || s->er.error_occurred ||
+        s->mb_y < VC1_PROGRESS_LAG)
+        return;
+    if (!v->field_mode)
+        row = s->mb_y - VC1_PROGRESS_LAG;
+    else if (v->second_field) // field row y covers frame rows 2y and 2y + 1
+        row = 2 * (s->mb_y - VC1_PROGRESS_LAG) + 1;
+    else
+        return;
+    ff_thread_progress_report(&s->cur_pic.ptr->progress, row);
+}
+
+/**
+ * Wait until a reference picture is final down to a line.
+ * @param last_line lowest luma line about to be read, as the current picture
+ *                  addresses it (a field line in a field picture)
+ */
+static av_always_inline void ff_vc1_await_ref(const VC1Context *v,
+                                              const MPVWorkPicture *ref,
+                                              int last_line)
+{
+    if (ref->ptr == v->s.cur_pic.ptr) // second field reading the first one
+        return;
+    if (v->field_mode)
+        last_line = 2 * last_line + 1;
+    ff_thread_progress_await(&ref->ptr->progress, last_line >> 4);
+}
+
 #endif /* AVCODEC_VC1_H */
