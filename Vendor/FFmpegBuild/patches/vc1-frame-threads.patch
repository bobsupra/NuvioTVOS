@@ -2831,6 +2833,7 @@ static void vc1_decode_p_blocks(VC1Context *v)
                 v->luma_mv - s->mb_stride,
                 sizeof(v->luma_mv_base[0]) * 2 * s->mb_stride);
         s->first_slice_line = 0;
