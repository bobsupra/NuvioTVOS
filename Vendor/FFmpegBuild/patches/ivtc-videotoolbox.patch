+    id mtlDevice;
+    id mtlLibrary;
+    id mtlQueue;
+    id mtlPipeline[NB_KERNELS];
+    id mapBuf[2];                   ///< diff map per plane
+    id maskBuf[MAX_CAND];           ///< comb mask per candidate
+    id matchBuf[2];                 ///< match_sums partials per plane
+    id combBuf[MAX_CAND];           ///< comb_count half-blocks per candidate
+    id lumaBuf[2];                  ///< luma_diff partials: prv-src, src-nxt
+    void *textureCache;             ///< CVMetalTextureCacheRef
+} FMVTContext;
