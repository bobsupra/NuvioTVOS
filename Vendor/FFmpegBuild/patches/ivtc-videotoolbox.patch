+/* Columns each partial-sum thread covers. */
+#define SEG 64
+/* At most three candidates are scored per frame: mC, fxo[mP] and the third
+ * match of pc_n or pc_u. */
+#define MAX_CAND 3
+
+/* The structs below must match the kernel parameter structs in
+ * metal/vf_fieldmatch_videotoolbox.metal. */
+struct fmvt_diff_map_params {
+    uint32_t width, height, channels, pbase, nbase, nk;
