+
+struct fmvt_weave_params {
+    uint32_t width, height, alt_parity;
+};
+
+/* The geometry of one plane of the input. */
+typedef struct FMVTPlane {
+    int w, h;          ///< in texels
+    int channels;      ///< 1 (Y) or 2 (UV)
+    int startx, stopx; ///< compare_fields' column range
+    int nk;            ///< iterations of the compare_fields / build_diff_map y loop
+    int nseg;          ///< partial-sum threads per row
+} FMVTPlane;
+
+/* Metal objects are kept as plain id (this file is built without ARC) and
