+extern char ff_vf_decimate_videotoolbox_metallib_data[];
+extern unsigned int ff_vf_decimate_videotoolbox_metallib_len;
+
+/* Must match struct block_diff_params in metal/vf_decimate_videotoolbox.metal. */
+struct dmvt_block_diff_params {
+    uint32_t width, height, channels, hblockx, hblocky, ncx, ncy, stride;
+};
+
+struct qitem {
+    AVFrame *frame;
+    int64_t maxbdiff;
+    int64_t totdiff;
+    /* the GPU work measuring this frame against the one before it */
+    int pending;
+    id cmdbuf;                      ///< id<MTLCommandBuffer>, retained
+    id out[2];                      ///< id<MTLBuffer> per plane, half-block sums
+    CVMetalTextureRef tex[4];       ///< both frames' planes, held until the GPU is done
+};
+
+typedef struct DecimateVTContext {
+    const AVClass *class;
+    struct qitem *queue;    ///< window of cycle frames and the associated data diff
+    int fid;                ///< current frame id in the queue
+    AVFrame *last;          ///< last frame from the previous queue
+    int got_frame;          ///< frame request flag
+    int64_t last_pts;       ///< last output timestamp
+    int64_t last_duration;  ///< last output duration
+    int64_t start_pts;      ///< base for output timestamps
+    uint32_t eof;           ///< end of stream
+    int failed;             ///< a GPU step failed; the queue is no longer consistent
+    int hsub, vsub;         ///< chroma subsampling values
+    int depth;
+    int nxblocks, nyblocks;
+    int bdiffsize;
+    int64_t *bdiffs;
+    int nb_planes;
+    int pw[2], ph[2], hbx[2], hby[2], ncx[2], ncy[2];
+    AVRational in_tb;       // input time-base
+    AVRational nondec_tb;   // non-decimated time-base
+    AVRational dec_tb;      // decimated time-base
+
+    /* options, the same names and defaults as decimate */
+    int cycle;
+    double dupthresh_flt;
+    double scthresh_flt;
+    int64_t dupthresh;
+    int64_t scthresh;
+    int blockx, blocky;
+    int ppsrc;
+    int chroma;
+    int mixed;
+
+    id mtlDevice;
+    id mtlLibrary;
+    id mtlQueue;
+    id mtlPipeline;
+    void *textureCache;     ///< CVMetalTextureCacheRef
+} DecimateVTContext;
+
+#define OFFSET(x) offsetof(DecimateVTContext, x)
+#define FLAGS AV_OPT_FLAG_VIDEO_PARAM|AV_OPT_FLAG_FILTERING_PARAM
+
+static const AVOption decimate_videotoolbox_options[] = {
+    { "cycle",     "set the number of frame from which one will be dropped", OFFSET(cycle), AV_OPT_TYPE_INT, {.i64 = 5}, 2, 25, FLAGS },
+    { "dupthresh", "set duplicate threshold",    OFFSET(dupthresh_flt), AV_OPT_TYPE_DOUBLE, {.dbl =  1.1}, 0, 100, FLAGS },
+    { "scthresh",  "set scene change threshold", OFFSET(scthresh_flt),  AV_OPT_TYPE_DOUBLE, {.dbl = 15.0}, 0, 100, FLAGS },
+    { "blockx",    "set the size of the x-axis blocks used during metric calculations", OFFSET(blockx), AV_OPT_TYPE_INT, {.i64 = 32}, 4, 1<<9, FLAGS },
+    { "blocky",    "set the size of the y-axis blocks used during metric calculations", OFFSET(blocky), AV_OPT_TYPE_INT, {.i64 = 32}, 4, 1<<9, FLAGS },
+    { "ppsrc",     "mark main input as a pre-processed input and activate clean source input stream", OFFSET(ppsrc), AV_OPT_TYPE_BOOL, {.i64=0}, 0, 1, FLAGS },
+    { "chroma",    "set whether or not chroma is considered in the metric calculations", OFFSET(chroma), AV_OPT_TYPE_BOOL, {.i64=1}, 0, 1, FLAGS },
+    { "mixed",     "set whether or not the input only partially contains content to be decimated", OFFSET(mixed), AV_OPT_TYPE_BOOL, {.i64=0}, 0, 1, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(decimate_videotoolbox);
+
+static void release_slot(struct qitem *q)
+{
+    for (int i = 0; i < 4; i++) {
+        if (q->tex[i]) {
+            CFRelease(q->tex[i]);
+            q->tex[i] = NULL;
+        }
+    }
+    ff_objc_release((NSObject **)&q->cmdbuf);
+    q->pending = 0;
+}
+
+/* Commits calc_diffs(prv, in) for one queue slot. The result is read by
+ * collect_metrics() once the cycle is complete. */
+static int submit_diffs(AVFilterContext *ctx, struct qitem *q,
+                        const AVFrame *f1, const AVFrame *f2) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    DecimateVTContext *dm = ctx->priv;
+    CVMetalTextureCacheRef cache = (CVMetalTextureCacheRef)dm->textureCache;
+    static const MTLPixelFormat formats[2] = { MTLPixelFormatR8Uint, MTLPixelFormatRG8Uint };
+    int ret = 0;
+
+    for (int p = 0; p < dm->nb_planes; p++) {
+        q->tex[p * 2    ] = ff_metal_texture_from_pixbuf(ctx, cache, (CVPixelBufferRef)f1->data[3], p, formats[p]);
+        q->tex[p * 2 + 1] = ff_metal_texture_from_pixbuf(ctx, cache, (CVPixelBufferRef)f2->data[3], p, formats[p]);
+        if (!q->tex[p * 2] || !q->tex[p * 2 + 1]) {
+            release_slot(q);
+            return AVERROR_EXTERNAL;
+        }
+    }
+
+    @autoreleasepool {
+        id<MTLCommandBuffer> buffer = ((id<MTLCommandQueue>)dm->mtlQueue).commandBuffer;
+        id<MTLComputeCommandEncoder> enc = buffer.computeCommandEncoder;
+        if (!buffer || !enc) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command buffer or encoder\n");
+            ret = AVERROR_EXTERNAL;
+        } else {
+            for (int p = 0; p < dm->nb_planes; p++) {
+                struct dmvt_block_diff_params bp = {
+                    .width = dm->pw[p], .height = dm->ph[p], .channels = p ? 2 : 1,
+                    .hblockx = dm->hbx[p], .hblocky = dm->hby[p],
+                    .ncx = dm->ncx[p], .ncy = dm->ncy[p], .stride = dm->nxblocks,
+                };
+                [enc setTexture:CVMetalTextureGetTexture(q->tex[p * 2    ]) atIndex:0];
+                [enc setTexture:CVMetalTextureGetTexture(q->tex[p * 2 + 1]) atIndex:1];
+                [enc setBuffer:(id<MTLBuffer>)q->out[p] offset:0 atIndex:0];
+                [enc setBytes:&bp length:sizeof(bp) atIndex:1];
+                ff_metal_compute_encoder_dispatch((id<MTLDevice>)dm->mtlDevice,
+                                                  (id<MTLComputePipelineState>)dm->mtlPipeline,
+                                                  enc, bp.ncx, bp.ncy);
+            }
+            [enc endEncoding];
+            [buffer commit];
+            /* The command buffer is autoreleased; keep it until collect_metrics() waits on it. */
+            q->cmdbuf = [buffer retain];
+            q->pending = 1;
+        }
+    }
+    if (ret < 0)
+        release_slot(q);
+    return ret;
+}
+
+/* Waits for one slot's GPU work and turns its half-block sums into
+ * calc_diffs' maxbdiff and totdiff. */
+static int collect_metrics(AVFilterContext *ctx, struct qitem *q) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    DecimateVTContext *dm = ctx->priv;
+    id<MTLCommandBuffer> buffer = (id<MTLCommandBuffer>)q->cmdbuf;
+    int64_t maxdiff = -1;
+    int64_t *bdiffs = dm->bdiffs;
+    int failed = 0;
+
+    if (!q->pending)
+        return 0;
+    [buffer waitUntilCompleted];
+    if (buffer.status == MTLCommandBufferStatusError) {
+        av_log(ctx, AV_LOG_ERROR, "Metal command buffer failed: %s\n",
+               buffer.error.description.UTF8String);
+        failed = 1;
+    }
+    release_slot(q);
+    if (failed)
+        return AVERROR_EXTERNAL;
+
+    memset(bdiffs, 0, dm->bdiffsize * sizeof(*bdiffs));
+    for (int p = 0; p < dm->nb_planes; p++) {
+        const uint32_t *half = ((id<MTLBuffer>)q->out[p]).contents;
+        for (int cy = 0; cy < dm->ncy[p]; cy++)
+            for (int cx = 0; cx < dm->ncx[p]; cx++)
+                bdiffs[cy * dm->nxblocks + cx] += half[cy * dm->nxblocks + cx];
+    }
+
+    for (int i = 0; i < dm->nyblocks - 1; i++) {
+        for (int j = 0; j < dm->nxblocks - 1; j++) {
+            int64_t tmp = bdiffs[      i * dm->nxblocks + j    ]
+                        + bdiffs[      i * dm->nxblocks + j + 1]
+                        + bdiffs[(i + 1) * dm->nxblocks + j    ]
+                        + bdiffs[(i + 1) * dm->nxblocks + j + 1];
+            if (tmp > maxdiff)
+                maxdiff = tmp;
+        }
+    }
+
+    q->totdiff = 0;
+    for (int i = 0; i < dm->bdiffsize; i++)
+        q->totdiff += bdiffs[i];
+    q->maxbdiff = maxdiff;
+    return 0;
+}
+
+/* Waits for every slot still on the GPU, without using the results. */
+static void drain_slots(DecimateVTContext *dm) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    if (!dm->queue)
+        return;
+    for (int i = 0; i < dm->cycle; i++) {
+        if (dm->queue[i].pending)
+            [(id<MTLCommandBuffer>)dm->queue[i].cmdbuf waitUntilCompleted];
+        release_slot(&dm->queue[i]);
+    }
+}
+
+static int filter_frame(AVFilterLink *inlink, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    int scpos = -1, duppos = -1;
+    int drop = INT_MIN, i, lowest = 0, ret;
+    AVFilterContext *ctx  = inlink->dst;
+    AVFilterLink *outlink = ctx->outputs[0];
+    DecimateVTContext *dm = ctx->priv;
+    AVFrame *prv;
+
+    /* After a GPU failure fid may equal cycle and a slot may hold a frame that was never
+     * measured, so nothing more goes into the queue. The queued frames are freed at uninit. */
+    if (dm->failed) {
+        av_frame_free(&in);
+        return AVERROR_EXTERNAL;
+    }
+
+    /* update frames queue */
+    dm->queue[dm->fid].frame = in;
+
+    if (in) {
+        /* update frame metrics */
+        prv = dm->fid ? dm->queue[dm->fid - 1].frame : dm->last;
+        if (!prv) {
+            dm->queue[dm->fid].maxbdiff = INT64_MAX;
+            dm->queue[dm->fid].totdiff  = INT64_MAX;
+        } else {
+            ret = submit_diffs(ctx, &dm->queue[dm->fid], prv, in);
+            if (ret < 0) {
+                dm->failed = 1;
+                return ret;
+            }
+        }
+        if (++dm->fid != dm->cycle)
+            return 0;
+
+        /* The cycle is complete. One wait covers the whole cycle's metrics. */
+        for (i = 0; i < dm->cycle; i++) {
+            ret = collect_metrics(ctx, &dm->queue[i]);
+            if (ret < 0) {
+                dm->failed = 1;
+                return ret;
+            }
+        }
+
+        av_frame_free(&dm->last);
+        dm->last = av_frame_clone(in);
+        dm->fid = 0;
+
+        /* we have a complete cycle, select the frame to drop */
+        lowest = 0;
+        for (i = 0; i < dm->cycle; i++) {
+            if (dm->queue[i].totdiff > dm->scthresh)
+                scpos = i;
+            if (dm->queue[i].maxbdiff < dm->queue[lowest].maxbdiff)
+                lowest = i;
+        }
+        if (dm->queue[lowest].maxbdiff < dm->dupthresh)
+            duppos = lowest;
+
+        if (dm->mixed && duppos < 0) {
+            drop = -1; // no drop if mixed content + no frame in cycle below threshold
+        } else {
+            drop = scpos >= 0 && duppos < 0 ? scpos : lowest;
+        }
+    } else {
+        /* End of stream: the partial cycle goes out undecimated. Its metrics are
+         * still read, because vf_decimate.c has them by now and logs them. */
+        for (i = 0; i < dm->cycle; i++) {
+            ret = collect_metrics(ctx, &dm->queue[i]);
+            if (ret < 0) {
+                dm->failed = 1;
+                return ret;
+            }
+        }
+    }
+
+    /* metrics debug */
+    if (av_log_get_level() >= AV_LOG_DEBUG) {
+        av_log(ctx, AV_LOG_DEBUG, "1/%d frame drop:\n", dm->cycle);
+        for (i = 0; i < dm->cycle && dm->queue[i].frame; i++) {
+            av_log(ctx, AV_LOG_DEBUG,"  #%d: totdiff=%08"PRIx64" maxbdiff=%08"PRIx64"%s%s%s%s\n",
+                   i + 1, dm->queue[i].totdiff, dm->queue[i].maxbdiff,
+                   i == scpos  ? " sc"     : "",
+                   i == duppos ? " dup"    : "",
+                   i == lowest ? " lowest" : "",
+                   i == drop   ? " [DROP]" : "");
+        }
+    }
+
+    /* push all frames except the drop */
+    ret = 0;
+    for (i = 0; i < dm->cycle && dm->queue[i].frame; i++) {
+        if (i == drop) {
+            av_frame_free(&dm->queue[i].frame);
+        } else {
+            AVFrame *frame = dm->queue[i].frame;
+            dm->queue[i].frame = NULL;
+            if (frame->pts != AV_NOPTS_VALUE && dm->start_pts == AV_NOPTS_VALUE)
+                dm->start_pts = av_rescale_q(frame->pts, dm->in_tb, outlink->time_base);
+
+            frame->pts = dm->last_duration ? dm->last_pts + dm->last_duration :
+                         (dm->start_pts == AV_NOPTS_VALUE ? 0 : dm->start_pts);
+            frame->duration = dm->mixed ? av_div_q(drop < 0 ? dm->nondec_tb : dm->dec_tb, outlink->time_base).num : 1;
+            dm->last_duration = frame->duration;
+            dm->last_pts = frame->pts;
+            ret = ff_filter_frame(outlink, frame);
+            if (ret < 0)
+                break;
+        }
+    }
+
+    return ret;
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    DecimateVTContext *dm = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    AVFrame *frame = NULL;
+    int ret = 0, status;
+    int64_t pts;
+
+    FF_FILTER_FORWARD_STATUS_BACK_ALL(ctx->outputs[0], ctx);
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        if (!dm->eof && (ret = ff_inlink_consume_frame(inlink, &frame)) > 0) {
+            ret = filter_frame(inlink, frame);
+            if (ret < 0)
+                return ret;
+        }
+        if (ret < 0) {
+            return ret;
+        } else if (dm->eof) {
+            ff_outlink_set_status(ctx->outputs[0], AVERROR_EOF, dm->last_pts);
+            return 0;
+        } else if (ff_inlink_acknowledge_status(inlink, &status, &pts)) {
+            if (status == AVERROR_EOF) { // flushing
+                dm->eof = 1;
+                filter_frame(inlink, NULL);
+                ff_outlink_set_status(ctx->outputs[0], AVERROR_EOF, dm->last_pts);
+                return 0;
+            }
+        }
+
+        if (ff_inlink_queued_frames(inlink) > 0) {
+            ff_filter_set_ready(ctx, 100);
+        } else if (ff_outlink_frame_wanted(ctx->outputs[0])) {
+            ff_inlink_request_frame(inlink);
+        }
+        return 0;
+    }
+    return AVERROR(ENOSYS);
+}
+
+static av_cold void do_uninit(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    DecimateVTContext *dm = ctx->priv;
+
+    drain_slots(dm);
+    av_frame_free(&dm->last);
+    av_freep(&dm->bdiffs);
+    if (dm->queue) {
+        for (int i = 0; i < dm->cycle; i++) {
+            av_frame_free(&dm->queue[i].frame);
+            ff_objc_release((NSObject **)&dm->queue[i].out[0]);
+            ff_objc_release((NSObject **)&dm->queue[i].out[1]);
+        }
+    }
+    av_freep(&dm->queue);
+
+    ff_objc_release((NSObject **)&dm->mtlPipeline);
+    ff_objc_release((NSObject **)&dm->mtlQueue);
+    ff_objc_release((NSObject **)&dm->mtlLibrary);
+    ff_objc_release((NSObject **)&dm->mtlDevice);
+    if (dm->textureCache) {
+        CFRelease(dm->textureCache);
+        dm->textureCache = NULL;
+    }
+}
+
+static av_cold void decimate_videotoolbox_uninit(AVFilterContext *ctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        do_uninit(ctx);
+    }
+}
+
+static av_cold int do_init(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    DecimateVTContext *dm = ctx->priv;
+    id<MTLDevice> device;
+    id<MTLFunction> function;
+    NSError *err = nil;
+    CVMetalTextureCacheRef cache = NULL;
+    CVReturn cvret;
+
+    if (dm->ppsrc) {
+        av_log(ctx, AV_LOG_ERROR, "ppsrc is not supported\n");
+        return AVERROR(ENOSYS);
+    }
+    if ((dm->blockx & (dm->blockx - 1)) ||
+        (dm->blocky & (dm->blocky - 1))) {
+        av_log(ctx, AV_LOG_ERROR, "blockx and blocky settings must be power of two\n");
+        return AVERROR(EINVAL);
+    }
+
+    dm->start_pts = AV_NOPTS_VALUE;
+    dm->last_duration = 0;
+
+    device = MTLCreateSystemDefaultDevice();
+    dm->mtlDevice = device;
+    if (!device) {
+        av_log(ctx, AV_LOG_ERROR, "Unable to find Metal device\n");
+        goto fail;
+    }
+    av_log(ctx, AV_LOG_INFO, "Using Metal device: %s\n", device.name.UTF8String);
+
+    dispatch_data_t libData = dispatch_data_create(
+        ff_vf_decimate_videotoolbox_metallib_data,
+        ff_vf_decimate_videotoolbox_metallib_len,
+        nil,
+        nil);
+    dm->mtlLibrary = [device newLibraryWithData:libData error:&err];
+    dispatch_release(libData);
+    libData = nil;
+    if (err) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to load Metal library: %s\n", err.description.UTF8String);
+        goto fail;
+    }
+
+    function = [(id<MTLLibrary>)dm->mtlLibrary newFunctionWithName:@"block_diff"];
+    if (!function) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal function!\n");
+        goto fail;
+    }
+    dm->mtlPipeline = [device newComputePipelineStateWithFunction:function error:&err];
+    [function release];
+    if (err || !dm->mtlPipeline) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal compute pipeline: %s\n",
+               err ? err.description.UTF8String : "unknown");
+        goto fail;
+    }
+
+    dm->mtlQueue = device.newCommandQueue;
+    if (!dm->mtlQueue) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command queue!\n");
+        goto fail;
+    }
+
+    cvret = CVMetalTextureCacheCreate(NULL, NULL, device, NULL, &cache);
+    if (cvret != kCVReturnSuccess) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create CVMetalTextureCache: %d\n", cvret);
+        goto fail;
+    }
+    dm->textureCache = cache;
+
+    return 0;
+fail:
+    decimate_videotoolbox_uninit(ctx);
+    return AVERROR_EXTERNAL;
+}
+
+static av_cold int decimate_videotoolbox_init(AVFilterContext *ctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        return do_init(ctx);
+    } else {
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
+
+static int do_config_output(AVFilterLink *outlink) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FilterLink *outl     = ff_filter_link(outlink);
+    AVFilterContext *ctx = outlink->src;
+    DecimateVTContext *dm = ctx->priv;
+    const AVFilterLink *inlink = ctx->inputs[0];
+    FilterLink *inl = ff_filter_link(ctx->inputs[0]);
+    id<MTLDevice> device = (id<MTLDevice>)dm->mtlDevice;
+    AVRational fps = inl->frame_rate;
+    const AVHWFramesContext *frames;
+    const AVPixFmtDescriptor *pix_desc;
+    int max_value;
+    const int w = inlink->w;
+    const int h = inlink->h;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "A hardware frames reference is "
+               "required to associate the processing device.\n");
+        return AVERROR(EINVAL);
+    }
+    frames = (const AVHWFramesContext *)inl->hw_frames_ctx->data;
+    if (frames->sw_format != AV_PIX_FMT_NV12) {
+        av_log(ctx, AV_LOG_ERROR, "Pixel format %s is not supported, only nv12\n",
+               av_get_pix_fmt_name(frames->sw_format));
+        return AVERROR(ENOSYS);
+    }
+    pix_desc = av_pix_fmt_desc_get(frames->sw_format);
+
+    dm->hsub      = pix_desc->log2_chroma_w;
+    dm->vsub      = pix_desc->log2_chroma_h;
+    if (dm->chroma && ((dm->blockx / 2) >> dm->hsub == 0 || (dm->blocky / 2) >> dm->vsub == 0)) {
+        av_log(ctx, AV_LOG_ERROR, "blockx and blocky must be at least one chroma sample\n");
+        return AVERROR(EINVAL);
+    }
+    dm->depth     = pix_desc->comp[0].depth;
+    max_value     = (1 << dm->depth) - 1;
+    dm->scthresh  = (int64_t)(((int64_t)max_value *          w * h          * dm->scthresh_flt)  / 100);
+    dm->dupthresh = (int64_t)(((int64_t)max_value * dm->blockx * dm->blocky * dm->dupthresh_flt) / 100);
+    dm->nxblocks  = (w + dm->blockx/2 - 1) / (dm->blockx/2);
+    dm->nyblocks  = (h + dm->blocky/2 - 1) / (dm->blocky/2);
+    dm->bdiffsize = dm->nxblocks * dm->nyblocks;
+    dm->bdiffs    = av_malloc_array(dm->bdiffsize, sizeof(*dm->bdiffs));
+    dm->queue     = av_calloc(dm->cycle, sizeof(*dm->queue));
+    dm->in_tb     = inlink->time_base;
+    dm->nondec_tb = av_inv_q(fps);
+    dm->dec_tb    = av_mul_q(dm->nondec_tb, (AVRational){dm->cycle, dm->cycle - 1});
+
+    if (!dm->bdiffs || !dm->queue)
+        return AVERROR(ENOMEM);
+
+    /* calc_diffs' plane geometry: half-blocks of blockx/2 by blocky/2 on luma,
+     * shifted by the subsampling on chroma, all adding into the same array. */
+    dm->nb_planes = dm->chroma ? 2 : 1;
+    for (int p = 0; p < dm->nb_planes; p++) {
+        dm->pw[p]  = p ? AV_CEIL_RSHIFT(w, dm->hsub) : w;
+        dm->ph[p]  = p ? AV_CEIL_RSHIFT(h, dm->vsub) : h;
+        dm->hbx[p] = p ? (dm->blockx / 2) >> dm->hsub : dm->blockx / 2;
+        dm->hby[p] = p ? (dm->blocky / 2) >> dm->vsub : dm->blocky / 2;
+        dm->ncx[p] = (dm->pw[p] + dm->hbx[p] - 1) / dm->hbx[p];
+        dm->ncy[p] = (dm->ph[p] + dm->hby[p] - 1) / dm->hby[p];
+        if (dm->ncx[p] > dm->nxblocks || dm->ncy[p] > dm->nyblocks) {
+            av_log(ctx, AV_LOG_ERROR, "Unsupported frame geometry %dx%d\n", w, h);
+            return AVERROR(EINVAL);
+        }
+    }
+    for (int i = 0; i < dm->cycle; i++) {
+        for (int p = 0; p < dm->nb_planes; p++) {
+            dm->queue[i].out[p] = [device newBufferWithLength:dm->bdiffsize * sizeof(uint32_t)
+                                                      options:MTLResourceStorageModeShared];
+            if (!dm->queue[i].out[p])
+                return AVERROR(ENOMEM);
+        }
+    }
+
+    if (!fps.num || !fps.den) {
+        av_log(ctx, AV_LOG_ERROR, "The input needs a constant frame rate; "
+               "current rate of %d/%d is invalid\n", fps.num, fps.den);
+        return AVERROR(EINVAL);
+    }
+
+    /* Frames go out by reference, so the output shares the input's frames context. */
+    av_buffer_unref(&outl->hw_frames_ctx);
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+
+    if (dm->mixed) {
+        outlink->time_base = av_gcd_q(dm->nondec_tb, dm->dec_tb, AV_TIME_BASE / 2, AV_TIME_BASE_Q);
+        av_log(ctx, AV_LOG_VERBOSE, "FPS: %d/%d -> VFR (use %d/%d if CFR required)\n",
+            fps.num, fps.den, outlink->time_base.den, outlink->time_base.num);
+    } else {
+        outlink->time_base = dm->dec_tb;
+        outl->frame_rate = av_inv_q(outlink->time_base);
+        av_log(ctx, AV_LOG_VERBOSE, "FPS: %d/%d -> %d/%d\n",
+            fps.num, fps.den, outl->frame_rate.num, outl->frame_rate.den);
+    }
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    return 0;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        return do_config_output(outlink);
+    } else {
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
+
+static const AVFilterPad decimate_videotoolbox_inputs[] = {
+    {
+        .name          = "main",
+        .type          = AVMEDIA_TYPE_VIDEO,
+    },
+};
+
+static const AVFilterPad decimate_videotoolbox_outputs[] = {
+    {
+        .name          = "default",
+        .type          = AVMEDIA_TYPE_VIDEO,
+        .config_props  = config_output,
+    },
+};
+
+const FFFilter ff_vf_decimate_videotoolbox = {
+    .p.name        = "decimate_videotoolbox",
+    .p.description = NULL_IF_CONFIG_SMALL("Decimate VideoToolbox frames (post field matching filter) using Metal compute"),
+    .p.priv_class  = &decimate_videotoolbox_class,
+    .init          = decimate_videotoolbox_init,
