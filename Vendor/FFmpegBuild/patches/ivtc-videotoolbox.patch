+
+AVFILTER_DEFINE_CLASS(fieldmatch_videotoolbox);
+
+static int get_field_base(int match, int field)
+{
+    return match < 3 ? 2 - field : 1 + field;
+}
+
+static AVFrame *select_frame(FMVTContext *fm, int match)
+{
+    if      (match == mP || match == mB) return fm->prv;
+    else if (match == mN || match == mU) return fm->nxt;
+    else  /* match == mC */              return fm->src;
+}
+
+/* The rows create_weave_frame takes from the frame that is not src, and that frame. */
+static int weave_alt_parity(int match, int field)
+{
+    return (match == mP || match == mN) ? field : 1 - field;
+}
+
+/* The textures of one frame's two planes, as unsigned integers. */
+static int frame_textures(AVFilterContext *ctx, const AVFrame *frame,
+                          CVMetalTextureRef tex[2]) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FMVTContext *fm = ctx->priv;
+    CVPixelBufferRef pixbuf = (CVPixelBufferRef)frame->data[3];
+
+    tex[0] = ff_metal_texture_from_pixbuf(ctx, (CVMetalTextureCacheRef)fm->textureCache,
+                                          pixbuf, 0, MTLPixelFormatR8Uint);
+    tex[1] = ff_metal_texture_from_pixbuf(ctx, (CVMetalTextureCacheRef)fm->textureCache,
+                                          pixbuf, 1, MTLPixelFormatRG8Uint);
+    return tex[0] && tex[1] ? 0 : AVERROR_EXTERNAL;
+}
+
+static void release_textures(CVMetalTextureRef *tex, int nb)
+{
+    for (int i = 0; i < nb; i++) {
+        if (tex[i]) {
+            CFRelease(tex[i]);
+            tex[i] = NULL;
+        }
+    }
+}
+
+static id<MTLTexture> T(CVMetalTextureRef t) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    return CVMetalTextureGetTexture(t);
+}
+
+/* What one frame's measuring pass produces. */
+typedef struct FMVTMetrics {
+    uint64_t accum[6];          ///< Pc, Pm, Pml, Nc, Nm, Nml of compare_fields(mC, fxo[mP])
+    int combs[5];               ///< calc_combed_score per match, -1 if not computed
+    int64_t diff_prv_src;       ///< luma_abs_diff(prv, src), when computed
+    int64_t diff_src_nxt;       ///< luma_abs_diff(src, nxt), when computed
+} FMVTMetrics;
+
+/* compare_fields after its loops: the totals decide, exactly as in vf_fieldmatch.c. */
+static int compare_fields_decide(const uint64_t accum[6], int match1, int match2)
+{
+    uint64_t accumPc = accum[0], accumPm = accum[1], accumPml = accum[2];
+    uint64_t accumNc = accum[3], accumNm = accum[4], accumNml = accum[5];
+    int norm1, norm2, mtn1, mtn2;
+    float c1, c2, mr;
+    int ret;
+
+    if (accumPm < 500 && accumNm < 500 && (accumPml >= 500 || accumNml >= 500) &&
+        FFMAX(accumPml,accumNml) > 3*FFMIN(accumPml,accumNml)) {
+        accumPm = accumPml;
+        accumNm = accumNml;
+    }
+
+    norm1 = (int)((accumPc / 6.0f) + 0.5f);
+    norm2 = (int)((accumNc / 6.0f) + 0.5f);
+    mtn1  = (int)((accumPm / 6.0f) + 0.5f);
+    mtn2  = (int)((accumNm / 6.0f) + 0.5f);
+    c1 = ((float)FFMAX(norm1,norm2)) / ((float)FFMAX(FFMIN(norm1,norm2),1));
+    c2 = ((float)FFMAX(mtn1, mtn2))  / ((float)FFMAX(FFMIN(mtn1, mtn2), 1));
+    mr = ((float)FFMAX(mtn1, mtn2))  / ((float)FFMAX(FFMAX(norm1,norm2),1));
+    if (((mtn1 >=  500 || mtn2 >=  500) && (mtn1*2 < mtn2*1 || mtn2*2 < mtn1*1)) ||
+        ((mtn1 >= 1000 || mtn2 >= 1000) && (mtn1*3 < mtn2*2 || mtn2*3 < mtn1*2)) ||
+        ((mtn1 >= 2000 || mtn2 >= 2000) && (mtn1*5 < mtn2*4 || mtn2*5 < mtn1*4)) ||
+        ((mtn1 >= 4000 || mtn2 >= 4000) && c2 > c1))
+        ret = mtn1 > mtn2 ? match2 : match1;
+    else if (mr > 0.005 && FFMAX(mtn1, mtn2) > 150 && (mtn1*2 < mtn2*1 || mtn2*2 < mtn1*1))
+        ret = mtn1 > mtn2 ? match2 : match1;
+    else
+        ret = norm1 > norm2 ? match2 : match1;
+    return ret;
+}
+
+/* calc_combed_score after its loops: the half-block counts go into the
+ * overlapping blocks the way C_ARRAY_ADD adds them, then the largest wins.
+ * blockx and blocky are even, so every pixel of a half-block lands in the
+ * same four blocks as the half-block's first pixel. */
+static int combed_score(FMVTContext *fm, const uint32_t *half)
+{
+    int max_v = 0;
+
+    memset(fm->c_array, 0, fm->c_array_size * sizeof(*fm->c_array));
+    for (int hy = 0; hy < fm->nhy; hy++) {
+        const int temp1 = (hy >> 1) * fm->xblocks4;
+        const int temp2 = ((hy + 1) >> 1) * fm->xblocks4;
+        for (int hx = 0; hx < fm->nhx; hx++) {
+            const int v = half[hy * fm->nhx + hx];
+            const int box1 = (hx >> 1) * 4;
+            const int box2 = ((hx + 1) >> 1) * 4;
+            if (!v)
+                continue;
+            fm->c_array[temp1 + box1    ] += v;
+            fm->c_array[temp1 + box2 + 1] += v;
+            fm->c_array[temp2 + box1 + 2] += v;
+            fm->c_array[temp2 + box2 + 3] += v;
+        }
+    }
+    for (int x = 0; x < fm->c_array_size; x++)
+        if (fm->c_array[x] > max_v)
+            max_v = fm->c_array[x];
+    return max_v;
+}
+
+static void dispatch(FMVTContext *fm, id<MTLComputeCommandEncoder> encoder,
+                     int kernel, NSUInteger w, NSUInteger h) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    ff_metal_compute_encoder_dispatch((id<MTLDevice>)fm->mtlDevice,
+                                      (id<MTLComputePipelineState>)fm->mtlPipeline[kernel],
+                                      encoder, w, h);
+}
+
+/*
+ * One frame's measuring pass: everything the decision code may read, in one
+ * command buffer with one wait. Two encoders, because the second reads what
+ * the first writes (the diff maps and the comb masks).
+ *
+ * The CPU scores candidates lazily (checkmm). Here every candidate that the
+ * mode could ask for is scored up front, so the decision never needs a second
+ * round trip. The extra scores cannot change a result: the decision code reads
+ * only the scores the CPU filter would have computed.
+ */
+static int measure(AVFilterContext *ctx, int field, const int *fxo, const int *cand, int nb_cand,
+                   int want_luma, FMVTMetrics *mt) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FMVTContext *fm = ctx->priv;
+    CVMetalTextureRef tex[6] = { NULL };     /* prv Y/UV, src Y/UV, nxt Y/UV */
+    id<MTLTexture> t[3][2];
+    const int match1 = fxo[mC], match2 = fxo[mP];
+    const int fbase1 = get_field_base(match1, field);
+    const int fbase2 = get_field_base(match2, field);
+    const int prvbranch = (match1 >= 3 && field == 1) || (match1 < 3 && field != 1);
+    const int nb_planes = fm->mchroma ? 2 : 1;
+    int ret = 0;
+
+    if ((ret = frame_textures(ctx, fm->prv, &tex[0])) < 0 ||
+        (ret = frame_textures(ctx, fm->src, &tex[2])) < 0 ||
+        (ret = frame_textures(ctx, fm->nxt, &tex[4])) < 0)
+        goto end;
+    for (int f = 0; f < 3; f++)
+        for (int p = 0; p < 2; p++)
+            t[f][p] = T(tex[f * 2 + p]);
+
+#define FRAME_OF(match) ((match) == mP || (match) == mB ? 0 : (match) == mC ? 1 : 2)
+
+    @autoreleasepool {
+        id<MTLCommandBuffer> buffer = ((id<MTLCommandQueue>)fm->mtlQueue).commandBuffer;
+        id<MTLComputeCommandEncoder> enc;
+
+        if (!buffer) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command buffer\n");
+            ret = AVERROR_EXTERNAL;
+            goto pool_end;
+        }
+
+        /* Stage 1: the diff maps, the comb masks and the luma differences. */
+        enc = buffer.computeCommandEncoder;
+        if (!enc) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal compute encoder\n");
+            ret = AVERROR_EXTERNAL;
+            goto pool_end;
+        }
+        for (int p = 0; p < nb_planes; p++) {
+            const FMVTPlane *pl = &fm->plane[p];
+            struct fmvt_diff_map_params dp = {
+                .width = pl->w, .height = pl->h, .channels = pl->channels,
+                .pbase = prvbranch ? fbase1 - 2 : fbase1,
+                .nbase = prvbranch ? fbase2 - 2 : fbase2,
+                .nk = pl->nk,
+            };
+            [enc setTexture:t[FRAME_OF(match1)][p] atIndex:0];
+            [enc setTexture:t[FRAME_OF(match2)][p] atIndex:1];
+            [enc setBuffer:(id<MTLBuffer>)fm->mapBuf[p] offset:0 atIndex:0];
+            [enc setBytes:&dp length:sizeof(dp) atIndex:1];
+            dispatch(fm, enc, K_DIFF_MAP, pl->w, pl->h);
+        }
+        for (int c = 0; c < nb_cand; c++) {
+            const int m = cand[c];
+            struct fmvt_comb_params cp = {
+                .width = fm->plane[0].w, .height = fm->plane[0].h,
+                .alt_parity = m == mC ? 0 : weave_alt_parity(m, field),
+                .cthresh = fm->cthresh,
+                .xhalf = fm->blockx / 2, .yhalf = fm->blocky / 2,
+                .nhx = fm->nhx, .nhy = fm->nhy,
+            };
+            [enc setTexture:t[1][0] atIndex:0];
+            [enc setTexture:t[FRAME_OF(m)][0] atIndex:1];
+            [enc setBuffer:(id<MTLBuffer>)fm->maskBuf[c] offset:0 atIndex:0];
+            [enc setBytes:&cp length:sizeof(cp) atIndex:1];
+            dispatch(fm, enc, K_COMB_MASK, cp.width, cp.height);
+        }
+        if (want_luma) {
+            struct fmvt_luma_diff_params lp = {
+                .width = fm->plane[0].w, .height = fm->plane[0].h,
+                .seg = SEG, .nseg = fm->luma_nseg,
+            };
+            for (int i = 0; i < 2; i++) {
+                [enc setTexture:t[i][0] atIndex:0];
+                [enc setTexture:t[i + 1][0] atIndex:1];
+                [enc setBuffer:(id<MTLBuffer>)fm->lumaBuf[i] offset:0 atIndex:0];
+                [enc setBytes:&lp length:sizeof(lp) atIndex:1];
+                dispatch(fm, enc, K_LUMA_DIFF, lp.nseg, lp.height);
+            }
+        }
+        [enc endEncoding];
+
+        /* Stage 2: the match sums and the comb counts. A nil encoder here would
+         * commit stage 1 alone and leave the previous frame's sums in the buffers. */
+        enc = buffer.computeCommandEncoder;
+        if (!enc) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal compute encoder\n");
+            ret = AVERROR_EXTERNAL;
+            goto pool_end;
+        }
+        for (int p = 0; p < nb_planes; p++) {
+            const FMVTPlane *pl = &fm->plane[p];
+            const int vsub = p ? fm->vsub : 0;
+            struct fmvt_match_sums_params mp = {
+                .width = pl->w, .channels = pl->channels,
+                .fbase1 = fbase1, .fbase2 = fbase2,
+                .nk = pl->nk, .startx = pl->startx, .stopx = pl->stopx,
+                .y0a = fm->y0 >> vsub, .y1a = fm->y1 >> vsub,
+                .seg = SEG, .nseg = pl->nseg,
+            };
+            if (!pl->nseg || !pl->nk)
+                continue;
+            [enc setTexture:t[1][p] atIndex:0];
+            [enc setTexture:t[FRAME_OF(match1)][p] atIndex:1];
+            [enc setTexture:t[FRAME_OF(match2)][p] atIndex:2];
+            [enc setBuffer:(id<MTLBuffer>)fm->mapBuf[p] offset:0 atIndex:0];
+            [enc setBuffer:(id<MTLBuffer>)fm->matchBuf[p] offset:0 atIndex:1];
+            [enc setBytes:&mp length:sizeof(mp) atIndex:2];
+            dispatch(fm, enc, K_MATCH_SUMS, pl->nseg, pl->nk);
+        }
+        for (int c = 0; c < nb_cand; c++) {
+            struct fmvt_comb_params cp = {
+                .width = fm->plane[0].w, .height = fm->plane[0].h,
+                .xhalf = fm->blockx / 2, .yhalf = fm->blocky / 2,
+                .nhx = fm->nhx, .nhy = fm->nhy,
+            };
+            [enc setBuffer:(id<MTLBuffer>)fm->maskBuf[c] offset:0 atIndex:0];
+            [enc setBuffer:(id<MTLBuffer>)fm->combBuf[c] offset:0 atIndex:1];
+            [enc setBytes:&cp length:sizeof(cp) atIndex:2];
+            dispatch(fm, enc, K_COMB_COUNT, fm->nhx, fm->nhy);
+        }
+        [enc endEncoding];
+
+        [buffer commit];
+        [buffer waitUntilCompleted];
+        if (buffer.status == MTLCommandBufferStatusError) {
+            av_log(ctx, AV_LOG_ERROR, "Metal command buffer failed: %s\n",
+                   buffer.error.description.UTF8String);
+            ret = AVERROR_EXTERNAL;
+        }
+pool_end:;
+    }
+    if (ret < 0)
+        goto end;
+
+    memset(mt->accum, 0, sizeof(mt->accum));
+    for (int p = 0; p < nb_planes; p++) {
+        const FMVTPlane *pl = &fm->plane[p];
+        const uint32_t *part = ((id<MTLBuffer>)fm->matchBuf[p]).contents;
+        if (!pl->nseg || !pl->nk)
+            continue;
+        for (int i = 0; i < pl->nk * pl->nseg; i++)
+            for (int j = 0; j < 6; j++)
+                mt->accum[j] += part[i * 6 + j];
+    }
+    for (int i = 0; i < 5; i++)
+        mt->combs[i] = -1;
+    for (int c = 0; c < nb_cand; c++)
+        mt->combs[cand[c]] = combed_score(fm, ((id<MTLBuffer>)fm->combBuf[c]).contents);
+    if (want_luma) {
+        int64_t *d[2] = { &mt->diff_prv_src, &mt->diff_src_nxt };
+        for (int i = 0; i < 2; i++) {
+            const uint32_t *part = ((id<MTLBuffer>)fm->lumaBuf[i]).contents;
+            *d[i] = 0;
+            for (int j = 0; j < fm->luma_nseg * fm->plane[0].h; j++)
+                *d[i] += part[j];
+        }
+    }
+
+end:
+    release_textures(tex, 6);
+#undef FRAME_OF
+    return ret;
+}
+
+/* create_weave_frame for a match other than mC, on the GPU. */
+static int weave_frame(AVFilterContext *ctx, int match, int field, AVFrame **out) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FMVTContext *fm = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    const AVFrame *alt = select_frame(fm, match);
+    CVMetalTextureRef tex[6] = { NULL };     /* src Y/UV, alt Y/UV, dst Y/UV */
+    AVFrame *dst;
+    int failed = 0;
+
+    dst = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!dst)
+        return AVERROR(ENOMEM);
+    av_frame_copy_props(dst, fm->src);
+
+    if (frame_textures(ctx, fm->src, &tex[0]) < 0 ||
+        frame_textures(ctx, alt, &tex[2]) < 0 ||
+        frame_textures(ctx, dst, &tex[4]) < 0) {
+        failed = 1;
+        goto end;
+    }
+
+    @autoreleasepool {
+        id<MTLCommandBuffer> buffer = ((id<MTLCommandQueue>)fm->mtlQueue).commandBuffer;
+        id<MTLComputeCommandEncoder> enc = buffer.computeCommandEncoder;
+        if (!buffer || !enc) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command buffer or encoder\n");
+            failed = 1;
+        } else {
+            for (int p = 0; p < 2; p++) {
+                struct fmvt_weave_params wp = {
+                    .width = fm->plane[p].w, .height = fm->plane[p].h,
+                    .alt_parity = weave_alt_parity(match, field),
+                };
+                [enc setTexture:T(tex[p])     atIndex:0];
+                [enc setTexture:T(tex[2 + p]) atIndex:1];
+                [enc setTexture:T(tex[4 + p]) atIndex:2];
+                [enc setBytes:&wp length:sizeof(wp) atIndex:0];
+                dispatch(fm, enc, K_WEAVE, wp.width, wp.height);
+            }
+            [enc endEncoding];
+            [buffer commit];
+            [buffer waitUntilCompleted];
+            if (buffer.status == MTLCommandBufferStatusError) {
+                av_log(ctx, AV_LOG_ERROR, "Metal command buffer failed: %s\n",
+                       buffer.error.description.UTF8String);
+                failed = 1;
+            }
+        }
+    }
+
+end:
+    release_textures(tex, 6);
+    if (failed) {
+        av_frame_free(&dst);
+        return AVERROR_EXTERNAL;
+    }
+    CVBufferPropagateAttachments((CVPixelBufferRef)fm->src->data[3], (CVPixelBufferRef)dst->data[3]);
+    *out = dst;
+    return 0;
+}
+
+static const int fxo0m[] = { mP, mC, mN, mB, mU };
+static const int fxo1m[] = { mN, mC, mP, mU, mB };
+
+/* checkmm, reading scores measure() already computed. A score is copied into
+ * combs only where vf_fieldmatch.c would have computed it (LOAD_COMB), so the
+ * debug line shows the same values. */
+static int checkmm(const FMVTContext *fm, int *combs, const int *scores, int m1, int m2)
+{
+    if (combs[m1] < 0)
+        combs[m1] = scores[m1];
+    if (combs[m2] < 0)
+        combs[m2] = scores[m2];
+    av_assert0(combs[m1] >= 0 && combs[m2] >= 0);
+    if ((combs[m2] * 3 < combs[m1] || (combs[m2] * 2 < combs[m1] && combs[m1] > fm->combpel)) &&
+        abs(combs[m2] - combs[m1]) >= 30 && combs[m2] < fm->combpel)
+        return m2;
+    else
+        return m1;
+}
+
+static int filter_frame(AVFilterLink *inlink, AVFrame *in) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    AVFilterContext *ctx  = inlink->dst;
+    AVFilterLink *outlink = ctx->outputs[0];
+    FilterLink      *outl = ff_filter_link(outlink);
+    FMVTContext *fm = ctx->priv;
+    FMVTMetrics mt;
+    int combs[] = { -1, -1, -1, -1, -1 };
+    int cand[MAX_CAND], nb_cand = 0;
+    int order, field, match, interlaced_frame, sc = 0, ret = 0, want_combs, want_luma;
+    const int *fxo;
+    AVFrame *dst = NULL;
+
+    /* update frames queue */
+    if (fm->prv != fm->src) /* 2nd loop exception (1st has prv==src and we don't want to loose src) */
+        av_frame_free(&fm->prv);
+    fm->prv = fm->src;
+    fm->src = fm->nxt;
+    if (in)
+        fm->nxt = in;
+    if (!fm->prv)
+        fm->prv = fm->src;
+    if (!fm->prv) /* received only one frame at that point */
+        return 0;
+    av_assert0(fm->prv && fm->src && fm->nxt);
+    in = fm->src;
+
+    /* parity */
+    order = fm->order != FM_PARITY_AUTO ? fm->order : ((in->flags & AV_FRAME_FLAG_INTERLACED) ?
+                                                       !!(in->flags & AV_FRAME_FLAG_TOP_FIELD_FIRST) : 1);
+    field = fm->field != FM_PARITY_AUTO ? fm->field : order;
+    av_assert0(order == 0 || order == 1 || field == 0 || field == 1);
+    fxo = field ^ order ? fxo1m : fxo0m;
+
+    /* Everything the decision below may read, measured at once. */
+    want_combs = fm->combmatch != COMBMATCH_NONE;
+    want_luma  = fm->combmatch == COMBMATCH_SC;
+    if (want_combs) {
+        cand[nb_cand++] = mC;
+        cand[nb_cand++] = fxo[mP];
+        if (fm->mode == MODE_PC_N)
+            cand[nb_cand++] = fxo[mN];
+        else if (fm->mode == MODE_PC_U)
+            cand[nb_cand++] = fxo[mU];
+    }
+    ret = measure(ctx, field, fxo, cand, nb_cand, want_luma, &mt);
+    if (ret < 0)
+        return ret;
+
+    /* p/c selection */
+    match = compare_fields_decide(mt.accum, fxo[mC], fxo[mP]);
+
+    /* scene change check */
+    if (fm->combmatch == COMBMATCH_SC) {
+        if (fm->lastn == outl->frame_count_in - 1) {
+            if (fm->lastscdiff > fm->scthresh)
+                sc = 1;
+        } else if (mt.diff_prv_src > fm->scthresh) {
+            sc = 1;
+        }
+
+        if (!sc) {
+            fm->lastn = outl->frame_count_in;
+            fm->lastscdiff = mt.diff_src_nxt;
+            sc = fm->lastscdiff > fm->scthresh;
+        }
+    }
+
+    if (fm->combmatch == COMBMATCH_FULL || (fm->combmatch == COMBMATCH_SC && sc)) {
+        switch (fm->mode) {
+        /* 2-way p/c matches */
+        case MODE_PC:
+            match = checkmm(fm, combs, mt.combs, match, match == fxo[mP] ? fxo[mC] : fxo[mP]);
+            break;
+        case MODE_PC_N:
+            match = checkmm(fm, combs, mt.combs, match, fxo[mN]);
+            break;
+        case MODE_PC_U:
+            match = checkmm(fm, combs, mt.combs, match, fxo[mU]);
+            break;
+        default:
+            av_assert0(0);
+        }
+    }
+
+    /* keep fields as-is if not matched properly */
+    interlaced_frame = combs[match] >= fm->combpel;
+    if (interlaced_frame && fm->combmatch == COMBMATCH_FULL) {
+        match = mC;
+    }
+
+    /* get output frame and drop the others */
+    if (match == mC) {
+        dst = av_frame_clone(fm->src);
+        if (!dst)
+            return AVERROR(ENOMEM);
+    } else if ((ret = weave_frame(ctx, match, field, &dst)) < 0) {
+        return ret;
+    }
+
+    /* mark the frame we are unable to match properly as interlaced so a proper
+     * de-interlacer can take the relay */
+    if (interlaced_frame) {
+        dst->flags |= AV_FRAME_FLAG_INTERLACED;
+        av_log(ctx, AV_LOG_WARNING, "Frame #%"PRId64" at %s is still interlaced\n",
+               outl->frame_count_in, av_ts2timestr(in->pts, &inlink->time_base));
+        if (field)
+            dst->flags |= AV_FRAME_FLAG_TOP_FIELD_FIRST;
+        else
+            dst->flags &= ~AV_FRAME_FLAG_TOP_FIELD_FIRST;
+    } else
+        dst->flags &= ~AV_FRAME_FLAG_INTERLACED;
+
+    av_log(ctx, AV_LOG_DEBUG, "SC:%d | COMBS: %3d %3d %3d %3d %3d (combpel=%d)"
+           " match=%d combed=%s\n", sc, combs[0], combs[1], combs[2], combs[3], combs[4],
+           fm->combpel, match, (dst->flags & AV_FRAME_FLAG_INTERLACED) ? "YES" : "NO");
+
+    return ff_filter_frame(outlink, dst);
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AVFrame *frame = NULL;
+    int ret = 0, status;
+    int64_t pts;
+
+    FF_FILTER_FORWARD_STATUS_BACK_ALL(ctx->outputs[0], ctx);
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        if ((ret = ff_inlink_consume_frame(inlink, &frame)) > 0) {
+            ret = filter_frame(inlink, frame);
+            if (ret < 0)
+                return ret;
+        }
+        if (ret < 0) {
+            return ret;
+        } else if (ff_inlink_acknowledge_status(inlink, &status, &pts)) {
+            if (status == AVERROR_EOF) // flushing
+                ret = filter_frame(inlink, NULL);
+            ff_outlink_set_status(ctx->outputs[0], status, pts);
+            return ret;
+        } else {
+            FF_FILTER_FORWARD_WANTED(ctx->outputs[0], inlink);
+            return 0;
+        }
+    }
+    return AVERROR(ENOSYS);
+}
+
+static av_cold void do_uninit(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FMVTContext *fm = ctx->priv;
+
+    if (fm->prv != fm->src)
+        av_frame_free(&fm->prv);
+    if (fm->nxt != fm->src)
+        av_frame_free(&fm->nxt);
+    av_frame_free(&fm->src);
+    av_freep(&fm->c_array);
+
+    for (int i = 0; i < 2; i++) {
+        ff_objc_release((NSObject **)&fm->mapBuf[i]);
+        ff_objc_release((NSObject **)&fm->matchBuf[i]);
+        ff_objc_release((NSObject **)&fm->lumaBuf[i]);
+    }
+    for (int i = 0; i < MAX_CAND; i++) {
+        ff_objc_release((NSObject **)&fm->maskBuf[i]);
+        ff_objc_release((NSObject **)&fm->combBuf[i]);
+    }
+    for (int i = 0; i < NB_KERNELS; i++)
+        ff_objc_release((NSObject **)&fm->mtlPipeline[i]);
+    ff_objc_release((NSObject **)&fm->mtlQueue);
+    ff_objc_release((NSObject **)&fm->mtlLibrary);
+    ff_objc_release((NSObject **)&fm->mtlDevice);
+
+    if (fm->textureCache) {
+        CFRelease(fm->textureCache);
+        fm->textureCache = NULL;
+    }
+}
+
+static av_cold void fieldmatch_videotoolbox_uninit(AVFilterContext *ctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        do_uninit(ctx);
+    }
+}
+
+static av_cold int do_init(AVFilterContext *ctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FMVTContext *fm = ctx->priv;
+    id<MTLDevice> device;
+    NSError *err = nil;
+    CVMetalTextureCacheRef cache = NULL;
+    CVReturn ret;
+
+    /* What this port does not carry, refused before anything is allocated. */
+    if (fm->ppsrc) {
+        av_log(ctx, AV_LOG_ERROR, "ppsrc is not supported\n");
+        return AVERROR(ENOSYS);
+    }
+    if (fm->combdbg) {
+        av_log(ctx, AV_LOG_ERROR, "combdbg is not supported\n");
+        return AVERROR(ENOSYS);
+    }
+    if (fm->chroma) {
+        av_log(ctx, AV_LOG_ERROR, "chroma=1 is not supported\n");
+        return AVERROR(ENOSYS);
+    }
+    if (fm->mode != MODE_PC && fm->mode != MODE_PC_N && fm->mode != MODE_PC_U) {
+        av_log(ctx, AV_LOG_ERROR, "Only modes pc, pc_n and pc_u are supported\n");
+        return AVERROR(ENOSYS);
+    }
+    /* The same two checks as fieldmatch_init, so both filters take the same options. */
+    if ((fm->blockx & (fm->blockx - 1)) ||
+        (fm->blocky & (fm->blocky - 1))) {
+        av_log(ctx, AV_LOG_ERROR, "blockx and blocky settings must be power of two\n");
+        return AVERROR(EINVAL);
+    }
+    if (fm->combpel > fm->blockx * fm->blocky) {
+        av_log(ctx, AV_LOG_ERROR, "Combed pixel should not be larger than blockx x blocky\n");
+        return AVERROR(EINVAL);
+    }
+
+    device = MTLCreateSystemDefaultDevice();
+    fm->mtlDevice = device;
+    if (!device) {
+        av_log(ctx, AV_LOG_ERROR, "Unable to find Metal device\n");
+        goto fail;
+    }
+    av_log(ctx, AV_LOG_INFO, "Using Metal device: %s\n", device.name.UTF8String);
+
+    dispatch_data_t libData = dispatch_data_create(
+        ff_vf_fieldmatch_videotoolbox_metallib_data,
+        ff_vf_fieldmatch_videotoolbox_metallib_len,
+        nil,
+        nil);
+    fm->mtlLibrary = [device newLibraryWithData:libData error:&err];
+    dispatch_release(libData);
+    libData = nil;
+    if (err) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to load Metal library: %s\n", err.description.UTF8String);
+        goto fail;
+    }
+
+    for (int i = 0; i < NB_KERNELS; i++) {
+        id<MTLFunction> function = [(id<MTLLibrary>)fm->mtlLibrary
+            newFunctionWithName:kernel_names[i]];
+        if (!function) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal function %s\n", kernel_names[i].UTF8String);
+            goto fail;
+        }
+        fm->mtlPipeline[i] = [device newComputePipelineStateWithFunction:function error:&err];
+        [function release];
+        if (err || !fm->mtlPipeline[i]) {
+            av_log(ctx, AV_LOG_ERROR, "Failed to create Metal compute pipeline %s: %s\n",
+                   kernel_names[i].UTF8String, err ? err.description.UTF8String : "unknown");
+            goto fail;
+        }
+    }
+
+    fm->mtlQueue = device.newCommandQueue;
+    if (!fm->mtlQueue) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create Metal command queue!\n");
+        goto fail;
+    }
+
+    ret = CVMetalTextureCacheCreate(NULL, NULL, device, NULL, &cache);
+    if (ret != kCVReturnSuccess) {
+        av_log(ctx, AV_LOG_ERROR, "Failed to create CVMetalTextureCache: %d\n", ret);
+        goto fail;
+    }
+    fm->textureCache = cache;
+
+    return 0;
+fail:
+    fieldmatch_videotoolbox_uninit(ctx);
+    return AVERROR_EXTERNAL;
+}
+
+static av_cold int fieldmatch_videotoolbox_init(AVFilterContext *ctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        return do_init(ctx);
+    } else {
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
+
+static int do_config_input(AVFilterLink *inlink) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    FilterLink *l = ff_filter_link(inlink);
+    AVFilterContext *ctx = inlink->dst;
+    FMVTContext *fm = ctx->priv;
+    id<MTLDevice> device = (id<MTLDevice>)fm->mtlDevice;
+    const AVHWFramesContext *frames;
+    const AVPixFmtDescriptor *desc;
+    const int w = inlink->w, h = inlink->h;
+    int xblocks, yblocks;
+
+    if (!l->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "A hardware frames reference is "
+               "required to associate the processing device.\n");
+        return AVERROR(EINVAL);
+    }
+    frames = (const AVHWFramesContext *)l->hw_frames_ctx->data;
+
+    /* Refuse what the kernels cannot run before anything is allocated, so the
+     * graph fails at configuration instead of on every frame. */
+    if (frames->sw_format != AV_PIX_FMT_NV12) {
+        av_log(ctx, AV_LOG_ERROR, "Pixel format %s is not supported, only nv12\n",
+               av_get_pix_fmt_name(frames->sw_format));
+        return AVERROR(ENOSYS);
+    }
+    desc = av_pix_fmt_desc_get(frames->sw_format);
+    /* vf_fieldmatch.c reads one row past what it wrote on a plane with an odd
+     * number of rows, so only even plane heights are reproducible. */
+    if (h % 4) {
+        av_log(ctx, AV_LOG_ERROR, "Frame height %d is not a multiple of 4, which is not supported\n", h);
+        return AVERROR(ENOSYS);
+    }
+    if (w < 32 || h < 16) {
+        av_log(ctx, AV_LOG_ERROR, "Video smaller than 32x16 is not supported\n");
+        return AVERROR(EINVAL);
+    }
+
+    fm->vsub = desc->log2_chroma_h;
+    fm->scthresh = (int64_t)((w * h * 255.0 * fm->scthresh_flt) / 100.0);
+
+    for (int p = 0; p < 2; p++) {
+        FMVTPlane *pl = &fm->plane[p];
+        pl->w = p ? AV_CEIL_RSHIFT(w, desc->log2_chroma_w) : w;
+        pl->h = p ? AV_CEIL_RSHIFT(h, desc->log2_chroma_h) : h;
+        pl->channels = p ? 2 : 1;
+        pl->startx = p ? 8 >> desc->log2_chroma_w : 8;
+        pl->stopx = pl->w - pl->startx;
+        pl->nk = (pl->h - 3) / 2;
+        pl->nseg = pl->stopx > pl->startx ? (pl->stopx - pl->startx + SEG - 1) / SEG : 0;
+    }
+    fm->luma_nseg = (w + SEG - 1) / SEG;
+
+    /* calc_combed_score's block array, sized as vf_fieldmatch.c sizes it. */
+    xblocks = ((w + fm->blockx / 2) / fm->blockx) + 1;
+    yblocks = ((h + fm->blocky / 2) / fm->blocky) + 1;
+    fm->xblocks4 = xblocks << 2;
+    fm->c_array_size = (xblocks * yblocks) << 2;
+    fm->c_array = av_malloc_array(fm->c_array_size, sizeof(*fm->c_array));
+    fm->nhx = (w + fm->blockx / 2 - 1) / (fm->blockx / 2);
+    fm->nhy = (h + fm->blocky / 2 - 1) / (fm->blocky / 2);
+    if (!fm->c_array)
+        return AVERROR(ENOMEM);
+
+    for (int p = 0; p < 2; p++) {
+        const FMVTPlane *pl = &fm->plane[p];
+        fm->mapBuf[p] = [device newBufferWithLength:pl->w * pl->h * pl->channels
+                                            options:MTLResourceStorageModePrivate];
+        fm->matchBuf[p] = [device newBufferWithLength:FFMAX(pl->nk * pl->nseg, 1) * 6 * sizeof(uint32_t)
+                                              options:MTLResourceStorageModeShared];
+        fm->lumaBuf[p] = [device newBufferWithLength:fm->luma_nseg * h * sizeof(uint32_t)
+                                             options:MTLResourceStorageModeShared];
+        if (!fm->mapBuf[p] || !fm->matchBuf[p] || !fm->lumaBuf[p])
+            return AVERROR(ENOMEM);
+    }
+    for (int c = 0; c < MAX_CAND; c++) {
+        fm->maskBuf[c] = [device newBufferWithLength:w * h options:MTLResourceStorageModePrivate];
+        fm->combBuf[c] = [device newBufferWithLength:fm->nhx * fm->nhy * sizeof(uint32_t)
+                                             options:MTLResourceStorageModeShared];
+        if (!fm->maskBuf[c] || !fm->combBuf[c])
+            return AVERROR(ENOMEM);
+    }
+
+    return 0;
+}
+
+static int config_input(AVFilterLink *inlink)
+{
+    AVFilterContext *ctx = inlink->dst;
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        return do_config_input(inlink);
+    } else {
+        av_log(ctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    FilterLink     *outl  = ff_filter_link(outlink);
+    AVFilterContext *ctx  = outlink->src;
+    AVFilterLink *inlink  = ctx->inputs[0];
+    FilterLink      *inl  = ff_filter_link(inlink);
+
+    /* Matched frames are either the input frame itself or a new frame of the
+     * same pool, so the output shares the input's frames context. */
+    av_buffer_unref(&outl->hw_frames_ctx);
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+
+    outlink->time_base = inlink->time_base;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    outl->frame_rate = inl->frame_rate;
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    return 0;
+}
+
+static const AVFilterPad fieldmatch_videotoolbox_inputs[] = {
+    {
+        .name          = "main",
+        .type          = AVMEDIA_TYPE_VIDEO,
+        .config_props  = config_input,
+    },
+};
+
+static const AVFilterPad fieldmatch_videotoolbox_outputs[] = {
+    {
+        .name          = "default",
+        .type          = AVMEDIA_TYPE_VIDEO,
+        .config_props  = config_output,
+    },
+};
+
+const FFFilter ff_vf_fieldmatch_videotoolbox = {
+    .p.name         = "fieldmatch_videotoolbox",
+    .p.description  = NULL_IF_CONFIG_SMALL("Field matching for inverse telecine of VideoToolbox frames using Metal compute"),
+    .p.priv_class   = &fieldmatch_videotoolbox_class,
+    .priv_size      = sizeof(FMVTContext),
+    .init           = fieldmatch_videotoolbox_init,
+    .activate       = activate,
+    .uninit         = fieldmatch_videotoolbox_uninit,
+    FILTER_INPUTS(fieldmatch_videotoolbox_inputs),
+    FILTER_OUTPUTS(fieldmatch_videotoolbox_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_VIDEOTOOLBOX),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
