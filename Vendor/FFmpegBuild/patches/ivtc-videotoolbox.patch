diff --git a/libavfilter/metal/vf_decimate_videotoolbox.metal b/libavfilter/metal/vf_decimate_videotoolbox.metal
new file mode 100644
index 0000000..7ca60df
--- /dev/null
+++ b/libavfilter/metal/vf_decimate_videotoolbox.metal
@@ -0,0 +1,69 @@
+/*
+ * Frame decimation for VideoToolbox frames, Metal compute kernel.
+ *
+ * The metric of libavfilter/vf_decimate.c (calc_diffs): the sum of absolute
+ * differences between two frames over each half-block. The filter adds the
+ * half-blocks into vf_decimate.c's blocks on the CPU and runs its decision
+ * code unchanged.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <metal_stdlib>
+#include <metal_integer>
+#include <metal_texture>
+
+using namespace metal;
+
+typedef texture2d<uint, access::read> utex;
+
+/* Must match struct dmvt_block_diff_params in vf_decimate_videotoolbox.m. */
+struct block_diff_params {
+    uint width;     /* plane width in texels */
+    uint height;    /* plane height in rows */
+    uint channels;  /* 1 (Y) or 2 (UV: U and V both add into the same half-block) */
+    uint hblockx;   /* half-block size on this plane */
+    uint hblocky;
+    uint ncx, ncy;  /* half-blocks on this plane */
+    uint stride;    /* half-blocks per row of the output, vf_decimate.c's nxblocks */
+};
+
+/* One half-block of one plane. Its sum is at most 256 * 256 * 255 * 2, which
+ * fits in 32 bits; the filter adds the planes in 64 bits, as calc_diffs does. */
+kernel void block_diff(utex a [[texture(0)]],
+                       utex b [[texture(1)]],
+                       device uint *out [[buffer(0)]],
+                       constant block_diff_params &p [[buffer(1)]],
+                       uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.ncx || gid.y >= p.ncy)
+        return;
+    const uint x0 = gid.x * p.hblockx, x1 = min(x0 + p.hblockx, p.width);
+    const uint y0 = gid.y * p.hblocky, y1 = min(y0 + p.hblocky, p.height);
+    uint sum = 0;
+
+    for (uint y = y0; y < y1; y++) {
+        for (uint x = x0; x < x1; x++) {
+            const uint4 va = a.read(uint2(x, y));
+            const uint4 vb = b.read(uint2(x, y));
+            sum += uint(abs(int(va.x) - int(vb.x)));
+            if (p.channels > 1)
+                sum += uint(abs(int(va.y) - int(vb.y)));
+        }
+    }
+    out[gid.y * p.stride + gid.x] = sum;
+}
diff --git a/libavfilter/metal/vf_fieldmatch_videotoolbox.metal b/libavfilter/metal/vf_fieldmatch_videotoolbox.metal
new file mode 100644
index 0000000..cbeee54
--- /dev/null
+++ b/libavfilter/metal/vf_fieldmatch_videotoolbox.metal
@@ -0,0 +1,336 @@
+/*
+ * Field matching for VideoToolbox frames, Metal compute kernels.
+ *
+ * Every kernel here is one loop of libavfilter/vf_fieldmatch.c (Fredrik Mellbin,
+ * Clement Boesch), done over the same 8-bit samples with the same integer
+ * arithmetic. The kernels only measure. The filter adds their per-thread
+ * partial sums on the CPU in 64 bits and runs vf_fieldmatch.c's decision code
+ * on the totals, so the matches it makes are the CPU filter's matches.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <metal_stdlib>
+#include <metal_integer>
+#include <metal_texture>
+
+using namespace metal;
+
+/* Planes are read as unsigned integer textures (R8Uint, RG8Uint), so there is
+ * no float conversion and the sample is the value. A two-channel plane (NV12's UV) carries
+ * U in .x and V in .y; the CPU filter treats them as two planes, so each lane
+ * is computed on its own and the lanes only meet in the sums. */
+typedef texture2d<uint, access::read> utex;
+typedef texture2d<uint, access::write> wtex;
+
+static inline int px(utex t, int x, int y, uint lane)
+{
+    uint4 v = t.read(uint2(uint(x), uint(y)));
+    return int(lane ? v.y : v.x);
+}
+
+/* Must match struct fmvt_diff_map_params in vf_fieldmatch_videotoolbox.m. */
+struct diff_map_params {
+    uint width;     /* plane width in texels */
+    uint height;    /* plane height in rows */
+    uint channels;  /* 1 or 2 */
+    uint pbase;     /* first row of the match1 field the absolute difference starts at */
+    uint nbase;     /* the same for match2 */
+    uint nk;        /* iterations of build_diff_map's y loop: y = 2, 4, ... < height - 2 */
+};
+
+/* One row of build_abs_diff_mask's tbuffer: |prv - nxt| on every other row. */
+static inline int absdiff(utex a, utex b, constant diff_map_params &p, int j, int x, uint lane)
+{
+    return abs(px(a, x, int(p.pbase) + 2 * j, lane) - px(b, x, int(p.nbase) + 2 * j, lane));
+}
+
+/* build_diff_map for one texel. k is the iteration of the y loop; the tbuffer
+ * row it centres on (dp) is k + 1. The loops, their early exits and their
+ * bounds are vf_fieldmatch.c's, line for line. */
+static inline uint diff_map_value(utex a, utex b, constant diff_map_params &p,
+                                  int k, int x, uint lane)
+{
+    const int width = int(p.width);
+    const int height = int(p.height);
+    const int y = 2 + 2 * k;
+    uint m = 0;
+    int u, count;
+    int diff = absdiff(a, b, p, k + 1, x, lane);
+
+    if (diff > 3) {
+        for (count = 0, u = x - 1; u < x + 2 && count < 2; u++) {
+            count += absdiff(a, b, p, k,     u, lane) > 3;
+            count += absdiff(a, b, p, k + 1, u, lane) > 3;
+            count += absdiff(a, b, p, k + 2, u, lane) > 3;
+        }
+        if (count > 1) {
+            m = 1;
+            if (diff > 19) {
+                int upper = 0, lower = 0;
+                for (count = 0, u = x - 1; u < x + 2 && count < 6; u++) {
+                    if (absdiff(a, b, p, k,     u, lane) > 19) { count++; upper = 1; }
+                    if (absdiff(a, b, p, k + 1, u, lane) > 19)   count++;
+                    if (absdiff(a, b, p, k + 2, u, lane) > 19) { count++; lower = 1; }
+                }
+                if (count > 3) {
+                    if (upper && lower) {
+                        m |= 1 << 1;
+                    } else {
+                        int upper2 = 0, lower2 = 0;
+                        for (u = max(x - 4, 0); u < min(x + 5, width); u++) {
+                            if (y != 2 &&          absdiff(a, b, p, k - 1, u, lane) > 19) upper2 = 1;
+                            if (                   absdiff(a, b, p, k,     u, lane) > 19) upper  = 1;
+                            if (                   absdiff(a, b, p, k + 2, u, lane) > 19) lower  = 1;
+                            if (y != height - 4 && absdiff(a, b, p, k + 3, u, lane) > 19) lower2 = 1;
+                        }
+                        if ((upper && (lower || upper2)) ||
+                            (lower && (upper || lower2)))
+                            m |= 1 << 1;
+                        else if (count > 5)
+                            m |= 1 << 2;
+                    }
+                }
+            }
+        }
+    }
+    return m;
+}
+
+/* The whole map plane, as compare_fields leaves it: zero (fill_buf) except on
+ * the rows build_diff_map writes, which are pbase + 2 + 2k, columns 1 to width - 2. */
+kernel void diff_map(utex prv [[texture(0)]],
+                     utex nxt [[texture(1)]],
+                     device uchar *map [[buffer(0)]],
+                     constant diff_map_params &p [[buffer(1)]],
+                     uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.width || gid.y >= p.height)
+        return;
+    const int x = int(gid.x), y = int(gid.y);
+    const int d = y - int(p.pbase) - 2;
+    const bool row = d >= 0 && (d & 1) == 0 && (d >> 1) < int(p.nk);
+    const bool col = x >= 1 && x < int(p.width) - 1;
+
+    for (uint lane = 0; lane < p.channels; lane++) {
+        uint m = row && col ? diff_map_value(prv, nxt, p, d >> 1, x, lane) : 0;
+        map[(gid.y * p.width + gid.x) * p.channels + lane] = uchar(m);
+    }
+}
+
+/* Must match struct fmvt_match_sums_params in vf_fieldmatch_videotoolbox.m. */
+struct match_sums_params {
+    uint width;
+    uint channels;
+    uint fbase1;    /* get_field_base(match1, field) */
+    uint fbase2;    /* get_field_base(match2, field) */
+    uint nk;
+    uint startx, stopx;
+    int y0a, y1a;
+    uint seg;       /* columns per thread */
+    uint nseg;
+};
+
+/* The accumulation loop of compare_fields. Each thread takes one y iteration
+ * and up to seg columns, and writes its six sums (Pc, Pm, Pml, Nc, Nm, Nml).
+ * A sum of at most seg * 1530 * 2 fits easily in 32 bits; the filter adds
+ * the partials in 64 bits, as the CPU's uint64_t accumulators do. */
+kernel void match_sums(utex src [[texture(0)]],
+                       utex prv [[texture(1)]],
+                       utex nxt [[texture(2)]],
+                       device const uchar *map [[buffer(0)]],
+                       device uint *out [[buffer(1)]],
+                       constant match_sums_params &p [[buffer(2)]],
+                       uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.nseg || gid.y >= p.nk)
+        return;
+    const int k = int(gid.y);
+    const int y = 2 + 2 * k;
+    uint aPc = 0, aPm = 0, aPml = 0, aNc = 0, aNm = 0, aNml = 0;
+
+    if (p.y0a == p.y1a || y < p.y0a || y > p.y1a) {
+        const int sf  = int(p.fbase1) + 1 + 2 * k;  /* srcf  */
+        const int pf  = int(p.fbase1) + 2 * k;      /* prvpf */
+        const int nf  = int(p.fbase2) + 2 * k;      /* nxtpf */
+        const int mr0 = int(p.fbase1) + 2 * k;      /* mapp */
+        const int x0 = int(p.startx + gid.x * p.seg);
+        const int x1 = min(x0 + int(p.seg), int(p.stopx));
+
+        for (int x = x0; x < x1; x++) {
+            for (uint lane = 0; lane < p.channels; lane++) {
+                const uint m0 = map[(uint(mr0)     * p.width + uint(x)) * p.channels + lane];
+                const uint m1 = map[(uint(mr0 + 2) * p.width + uint(x)) * p.channels + lane];
+                if (m0 > 0 || m1 > 0) {
+                    const int temp1 = px(src, x, sf - 2, lane) + (px(src, x, sf, lane) << 2)
+                                    + px(src, x, sf + 2, lane); /* [1 4 1] */
+                    int temp2 = abs(3 * (px(prv, x, pf, lane) + px(prv, x, pf + 2, lane)) - temp1);
+                    if (temp2 > 23 && ((m0 & 1) || (m1 & 1)))
+                        aPc += uint(temp2);
+                    if (temp2 > 42) {
+                        if ((m0 & 2) || (m1 & 2))
+                            aPm += uint(temp2);
+                        if ((m0 & 4) || (m1 & 4))
+                            aPml += uint(temp2);
+                    }
+
+                    temp2 = abs(3 * (px(nxt, x, nf, lane) + px(nxt, x, nf + 2, lane)) - temp1);
+                    if (temp2 > 23 && ((m0 & 1) || (m1 & 1)))
+                        aNc += uint(temp2);
+                    if (temp2 > 42) {
+                        if ((m0 & 2) || (m1 & 2))
+                            aNm += uint(temp2);
+                        if ((m0 & 4) || (m1 & 4))
+                            aNml += uint(temp2);
+                    }
+                }
+            }
+        }
+    }
+
+    device uint *o = out + (gid.y * p.nseg + gid.x) * 6;
+    o[0] = aPc; o[1] = aPm; o[2] = aPml;
+    o[3] = aNc; o[4] = aNm; o[5] = aNml;
+}
+
+/* Must match struct fmvt_comb_params in vf_fieldmatch_videotoolbox.m. */
+struct comb_params {
+    uint width;
+    uint height;
+    uint alt_parity;  /* rows with (y & 1) == alt_parity come from alt, the rest from src */
+    int cthresh;
+    uint xhalf, yhalf;
+    uint nhx, nhy;
+};
+
+/* A row of the candidate frame create_weave_frame would build, read in place. */
+static inline int wv(utex src, utex alt, constant comb_params &p, int x, int y)
+{
+    return (uint(y) & 1) == p.alt_parity ? px(alt, x, y, 0) : px(src, x, y, 0);
+}
+
+/* The first half of calc_combed_score on the luma plane: the [1 -3 4 -3 1]
+ * vertical test, with vf_fieldmatch.c's special cases for the two rows at
+ * each edge. mask is 1 where the CPU writes 0xff. */
+kernel void comb_mask(utex src [[texture(0)]],
+                      utex alt [[texture(1)]],
+                      device uchar *mask [[buffer(0)]],
+                      constant comb_params &p [[buffer(1)]],
+                      uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.width || gid.y >= p.height)
+        return;
+    const int x = int(gid.x), y = int(gid.y), h = int(p.height);
+    const int cthresh = p.cthresh, cthresh6 = cthresh * 6;
+    uchar m = 0;
+
+    if (cthresh < 0) {
+        m = 1;
+    } else {
+        const int c = wv(src, alt, p, x, y);
+#define S(dy) wv(src, alt, p, x, y + (dy))
+#define FILTER(xm2, xm1, xp1, xp2) \
+        (abs(4 * c - 3 * (S(xm1) + S(xp1)) + (S(xm2) + S(xp2))) > cthresh6)
+        if (y == 0) {
+            const int s1 = abs(c - S(1));
+            m = s1 > cthresh && FILTER(2, 1, 1, 2);
+        } else if (y == 1) {
+            const int s1 = abs(c - S(-1));
+            const int s2 = abs(c - S(1));
+            m = s1 > cthresh && s2 > cthresh && FILTER(2, -1, 1, 2);
+        } else if (y < h - 2) {
+            const int s1 = abs(c - S(-1));
+            const int s2 = abs(c - S(1));
+            m = s1 > cthresh && s2 > cthresh && FILTER(-2, -1, 1, 2);
+        } else if (y == h - 2) {
+            const int s1 = abs(c - S(-1));
+            const int s2 = abs(c - S(1));
+            m = s1 > cthresh && s2 > cthresh && FILTER(-2, -1, 1, -2);
+        } else {
+            const int s1 = abs(c - S(-1));
+            m = s1 > cthresh && FILTER(-2, -1, -1, -2);
+        }
+#undef FILTER
+#undef S
+    }
+    mask[gid.y * p.width + gid.x] = m;
+}
+
+/* The second half of calc_combed_score: how many pixels in each half-block
+ * (xhalf by yhalf) are combed on their own row and the rows above and below,
+ * over rows 1 to height - 2. The filter adds the half-blocks into
+ * vf_fieldmatch.c's overlapping blocks (C_ARRAY_ADD) and takes the maximum. */
+kernel void comb_count(device const uchar *mask [[buffer(0)]],
+                       device uint *out [[buffer(1)]],
+                       constant comb_params &p [[buffer(2)]],
+                       uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.nhx || gid.y >= p.nhy)
+        return;
+    const uint x0 = gid.x * p.xhalf, x1 = min(x0 + p.xhalf, p.width);
+    const uint y0 = max(gid.y * p.yhalf, 1u), y1 = min(gid.y * p.yhalf + p.yhalf, p.height - 1);
+    uint sum = 0;
+
+    for (uint y = y0; y < y1; y++)
+        for (uint x = x0; x < x1; x++)
+            sum += mask[(y - 1) * p.width + x] && mask[y * p.width + x] && mask[(y + 1) * p.width + x];
+    out[gid.y * p.nhx + gid.x] = sum;
+}
+
+/* Must match struct fmvt_luma_diff_params in vf_fieldmatch_videotoolbox.m. */
+struct luma_diff_params {
+    uint width;
+    uint height;
+    uint seg;
+    uint nseg;
+};
+
+/* luma_abs_diff, for the scene change check of combmatch=sc. */
+kernel void luma_diff(utex a [[texture(0)]],
+                      utex b [[texture(1)]],
+                      device uint *out [[buffer(0)]],
+                      constant luma_diff_params &p [[buffer(1)]],
+                      uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.nseg || gid.y >= p.height)
+        return;
+    const int x0 = int(gid.x * p.seg), x1 = min(x0 + int(p.seg), int(p.width));
+    uint sum = 0;
+    for (int x = x0; x < x1; x++)
+        sum += uint(abs(px(a, x, int(gid.y), 0) - px(b, x, int(gid.y), 0)));
+    out[gid.y * p.nseg + gid.x] = sum;
+}
+
+/* Must match struct fmvt_weave_params in vf_fieldmatch_videotoolbox.m. */
+struct weave_params {
+    uint width;
+    uint height;
+    uint alt_parity;
+};
+
+/* create_weave_frame: rows of one parity from alt, the others from src. */
+kernel void weave(utex src [[texture(0)]],
+                  utex alt [[texture(1)]],
+                  wtex dst [[texture(2)]],
+                  constant weave_params &p [[buffer(0)]],
+                  uint2 gid [[thread_position_in_grid]])
+{
+    if (gid.x >= p.width || gid.y >= p.height)
+        return;
+    uint4 v = (gid.y & 1) == p.alt_parity ? alt.read(gid) : src.read(gid);
+    dst.write(v, gid);
+}
diff --git a/libavfilter/vf_decimate_videotoolbox.m b/libavfilter/vf_decimate_videotoolbox.m
new file mode 100644
index 0000000..7bf3899
--- /dev/null
+++ b/libavfilter/vf_decimate_videotoolbox.m
@@ -0,0 +1,655 @@
+/*
+ * Frame decimation for VideoToolbox frames, using Metal compute.
+ *
+ * A port of libavfilter/vf_decimate.c (Fredrik Mellbin 2012, Clement Boesch
+ * 2013) for AV_PIX_FMT_VIDEOTOOLBOX frames. Only the frame metric runs on the
+ * GPU (metal/vf_decimate_videotoolbox.metal); the queue, the choice of the
+ * frame to drop and the timestamps are vf_decimate.c's code. Frames are passed
+ * on by reference, so the output is the CPU filter's output.
+ *
+ * vf_decimate.c reads the metrics only once a cycle is complete, so each
+ * frame's metric is committed to the GPU without waiting, and the filter waits
+ * once per cycle, before it decides.
+ *
+ * Supported: NV12 (8-bit 4:2:0). Refused: ppsrc.
