+
+/*
+ * Lazy fragment index (option lazy_frag_index).
+ *
+ * A fragmented file without a complete sidx is normally indexed by reading every
+ * top-level moof before the header returns, one seek per fragment. With the option,
+ * the header stops after the first moof and a seek finds its fragment on demand:
+ * it estimates a byte offset, resynchronises on the next moof, checks that it really
+ * is one, reads its tfdt and bisects on that. Only fragments reached that way, or by
+ * walking the box chain from one, are ever used, so the estimate decides how many
+ * reads a seek takes and never where it lands.
+ */
+#define MOV_LAZY_PROBE     8192
+#define MOV_LAZY_CHUNK     65536
+#define MOV_LAZY_MAX_MOOF  (32 << 20)
+#define MOV_LAZY_MAX_TRAFS 64
+#define MOV_LAZY_END       (-1)
+#define MOV_LAZY_INVALID   (-2)
+
+/* Index of the first known fragment at or after offset. */
+static int mov_lazy_find(const MOVContext *c, int64_t offset)
+{
+    int a = 0, b = c->nb_lazy_frags;
+
+    while (a < b) {
+        int m = (a + b) >> 1;
+        if (c->lazy_frags[m].offset < offset)
+            a = m + 1;
+        else
+            b = m;
+    }
+    return a;
+}
+
+static int mov_lazy_add(MOVContext *c, const MOVLazyFrag *frag)
+{
+    int index = mov_lazy_find(c, frag->offset);
+    MOVLazyFrag *tab;
+
+    if (index < c->nb_lazy_frags && c->lazy_frags[index].offset == frag->offset)
+        return index;
+    tab = av_fast_realloc(c->lazy_frags, &c->lazy_frags_allocated,
+                          (c->nb_lazy_frags + 1) * sizeof(*tab));
+    if (!tab)
+        return AVERROR(ENOMEM);
+    c->lazy_frags = tab;
+    memmove(tab + index + 1, tab + index, (c->nb_lazy_frags - index) * sizeof(*tab));
+    tab[index] = *frag;
+    c->nb_lazy_frags++;
+    if (frag->has_ref) {
+        c->lazy_dur_sum += frag->time_end - frag->time;
+        c->lazy_dur_count++;
+    }
+    return index;
+}
+
+static void mov_lazy_remove(MOVContext *c, int64_t offset)
+{
+    int index = mov_lazy_find(c, offset);
+
+    if (index >= c->nb_lazy_frags || c->lazy_frags[index].offset != offset)
+        return;
+    if (c->lazy_frags[index].has_ref) {
+        c->lazy_dur_sum -= c->lazy_frags[index].time_end - c->lazy_frags[index].time;
+        c->lazy_dur_count--;
+    }
+    memmove(c->lazy_frags + index, c->lazy_frags + index + 1,
+            (c->nb_lazy_frags - index - 1) * sizeof(*c->lazy_frags));
+    c->nb_lazy_frags--;
+}
+
+static int mov_lazy_read(AVIOContext *pb, int64_t pos, uint8_t *buf, int size)
+{
+    int ret;
+
+    if (avio_seek(pb, pos, SEEK_SET) < 0)
+        return 0;
+    ret = avio_read(pb, buf, size);
+    return FFMAX(ret, 0);
+}
+
+/**
+ * Check that buf holds a moof at file position offset, followed by its mdat, and
+ * describe it. Everything a false "moof" in sample data would have to get right:
+ * box sizes that add up exactly, mfhd first, track ids the moov declares, a tfdt
+ * for every track with samples, and sample data that lies inside the mdat.
+ *
+ * @return 0, AVERROR(EAGAIN) when len is short of FFMIN(size + 16, bytes left in
+ *         the file), AVERROR_INVALIDDATA when this is not a usable moof
+ */
+static int mov_lazy_parse_moof(MOVContext *c, const uint8_t *buf, int64_t len,
+                               int64_t offset, MOVLazyFrag *frag, int64_t *ends)
+{
+    int64_t file_size = c->lazy_size, left = file_size - offset;
+    int64_t size, p, mdat_size, mdat_hdr = 8, implicit = offset;
+    int64_t data_lo = INT64_MAX, data_hi = 0;
+    int     traf_stream[MOV_LAZY_MAX_TRAFS];
+    int64_t traf_end[MOV_LAZY_MAX_TRAFS];
+    int nb_trafs = 0, first = 1;
+
+    if (len < 8 || left < 8)
+        return AVERROR_INVALIDDATA;
+    size = AV_RB32(buf);
+    if (AV_RL32(buf + 4) != MKTAG('m','o','o','f') ||
+        size < 8 + 16 + 8 + 16 || size > MOV_LAZY_MAX_MOOF || size + 8 > left)
+        return AVERROR_INVALIDDATA;
+    if (len < FFMIN(size + 16, left))
+        return AVERROR(EAGAIN);
+
+    memset(frag, 0, sizeof(*frag));
+    frag->offset = offset;
+
+    for (p = 8; p < size;) {
+        int64_t cs;
+        uint32_t ct;
+
+        if (size - p < 8)
+            return AVERROR_INVALIDDATA;
+        cs = AV_RB32(buf + p);
+        ct = AV_RL32(buf + p + 4);
+        if (cs < 8 || cs > size - p)
+            return AVERROR_INVALIDDATA;
+        if (first) {
+            if (ct != MKTAG('m','f','h','d') || cs != 16)
+                return AVERROR_INVALIDDATA;
+            first = 0;
+        } else if (ct == MKTAG('t','r','a','f')) {
+            const uint8_t *t = buf + p;
+            int64_t q, base = -1, cur = -1, tfdt = AV_NOPTS_VALUE, dur_sum = 0;
+            int64_t samples = 0;
+            unsigned def_dur = 0, def_size = 0;
+            int stream = -1, tfhd = 0;
+
+            for (q = 8; q < cs;) {
+                const uint8_t *b = t + q;
+                int64_t bs;
+                uint32_t bt;
+
+                if (cs - q < 8)
+                    return AVERROR_INVALIDDATA;
+                bs = AV_RB32(b);
+                bt = AV_RL32(b + 4);
+                if (bs < 8 || bs > cs - q)
+                    return AVERROR_INVALIDDATA;
+                if (!tfhd && bt != MKTAG('t','f','h','d'))
+                    return AVERROR_INVALIDDATA;
+                if (bt == MKTAG('t','f','h','d')) {
+                    int64_t r = 16;
+                    unsigned flags, id;
+                    const MOVTrackExt *trex = NULL;
+
+                    if (tfhd || bs < 16)
+                        return AVERROR_INVALIDDATA;
+                    tfhd  = 1;
+                    flags = AV_RB24(b + 9);
+                    id    = AV_RB32(b + 12);
+                    for (int i = 0; i < c->trex_count; i++)
+                        if (c->trex_data[i].track_id == id)
+                            trex = &c->trex_data[i];
+                    for (int i = 0; i < c->fc->nb_streams; i++)
+                        if (((MOVStreamContext *)c->fc->streams[i]->priv_data)->id == id)
+                            stream = i;
+                    if (!trex || stream < 0)
+                        return AVERROR_INVALIDDATA;
+                    def_dur  = trex->duration;
+                    def_size = trex->size;
+                    if (flags & MOV_TFHD_BASE_DATA_OFFSET) {
+                        if (bs < r + 8)
+                            return AVERROR_INVALIDDATA;
+                        base = AV_RB64(b + r);
+                        r += 8;
+                    } else if (flags & MOV_TFHD_DEFAULT_BASE_IS_MOOF) {
+                        base = offset;
+                    } else {
+                        base = implicit;
+                    }
+                    if (flags & MOV_TFHD_STSD_ID)
+                        r += 4;
+                    if (flags & MOV_TFHD_DEFAULT_DURATION) {
+                        if (bs < r + 4)
+                            return AVERROR_INVALIDDATA;
+                        def_dur = AV_RB32(b + r);
+                        r += 4;
+                    }
+                    if (flags & MOV_TFHD_DEFAULT_SIZE) {
+                        if (bs < r + 4)
+                            return AVERROR_INVALIDDATA;
+                        def_size = AV_RB32(b + r);
+                        r += 4;
+                    }
+                    if (flags & MOV_TFHD_DEFAULT_FLAGS)
+                        r += 4;
+                    if (bs < r || base < 0)
+                        return AVERROR_INVALIDDATA;
+                    cur = base;
+                } else if (bt == MKTAG('t','f','d','t')) {
+                    if (bs < 16 || (b[8] && bs < 20))
+                        return AVERROR_INVALIDDATA;
+                    tfdt = b[8] ? AV_RB64(b + 12) : AV_RB32(b + 12);
+                    if (tfdt < 0)
+                        return AVERROR_INVALIDDATA;
+                } else if (bt == MKTAG('t','r','u','n')) {
+                    int64_t r = 16, n, es, bytes = 0, dur = 0;
+                    unsigned flags;
+
+                    if (bs < 16)
+                        return AVERROR_INVALIDDATA;
+                    flags = AV_RB24(b + 9);
+                    n     = AV_RB32(b + 12);
+                    if (flags & MOV_TRUN_DATA_OFFSET) {
+                        if (bs < r + 4)
+                            return AVERROR_INVALIDDATA;
+                        cur = base + (int32_t)AV_RB32(b + r);
+                        r += 4;
+                    }
+                    if (flags & MOV_TRUN_FIRST_SAMPLE_FLAGS)
+                        r += 4;
+                    es = !!(flags & MOV_TRUN_SAMPLE_DURATION) * 4 +
+                         !!(flags & MOV_TRUN_SAMPLE_SIZE)     * 4 +
+                         !!(flags & MOV_TRUN_SAMPLE_FLAGS)    * 4 +
+                         !!(flags & MOV_TRUN_SAMPLE_CTS)      * 4;
+                    if (bs < r || (es && (bs - r) / es < n) || n > INT_MAX)
+                        return AVERROR_INVALIDDATA;
+                    if (flags & (MOV_TRUN_SAMPLE_DURATION | MOV_TRUN_SAMPLE_SIZE)) {
+                        const uint8_t *e = b + r;
+                        int size_at = !!(flags & MOV_TRUN_SAMPLE_DURATION) * 4;
+                        for (int64_t i = 0; i < n; i++, e += es) {
+                            dur   += flags & MOV_TRUN_SAMPLE_DURATION ? AV_RB32(e) : def_dur;
+                            bytes += flags & MOV_TRUN_SAMPLE_SIZE ? AV_RB32(e + size_at) : def_size;
+                        }
+                    } else {
+                        dur   = n * def_dur;
+                        bytes = n * def_size;
+                    }
+                    if (n) {
+                        if (cur < 0 || !bytes)
+                            return AVERROR_INVALIDDATA;
+                        data_lo  = FFMIN(data_lo, cur);
+                        cur     += bytes;
+                        data_hi  = FFMAX(data_hi, cur);
+                        dur_sum += dur;
+                        samples += n;
+                    }
+                }
+                q += bs;
+            }
+            if (!tfhd)
+                return AVERROR_INVALIDDATA;
+            if (samples) {
+                /* Without a tfdt the fragment's time is only known by reading
+                 * every fragment before it. */
+                if (tfdt == AV_NOPTS_VALUE || nb_trafs == MOV_LAZY_MAX_TRAFS ||
+                    dur_sum > INT64_MAX - tfdt)
+                    return AVERROR_INVALIDDATA;
+                traf_stream[nb_trafs] = stream;
+                traf_end[nb_trafs++]  = tfdt + dur_sum;
+                if (stream == c->lazy_ref_stream && !frag->has_ref) {
+                    frag->has_ref  = 1;
+                    frag->time     = tfdt;
+                    frag->time_end = tfdt + dur_sum;
+                }
+                implicit = cur;
+            }
+        }
+        p += cs;
+    }
+    if (!nb_trafs)
+        return AVERROR_INVALIDDATA;
+
+    /* the mdat the samples are in */
+    if (AV_RL32(buf + size + 4) != MKTAG('m','d','a','t'))
+        return AVERROR_INVALIDDATA;
+    mdat_size = AV_RB32(buf + size);
+    if (mdat_size == 1) {
+        if (left < size + 16)
+            return AVERROR_INVALIDDATA;
+        mdat_size = AV_RB64(buf + size + 8);
+        mdat_hdr  = 16;
+    } else if (!mdat_size) {
+        mdat_size = left - size;
+    }
+    if (mdat_size < mdat_hdr || mdat_size > left - size)
+        return AVERROR_INVALIDDATA;
+    frag->end = offset + size + mdat_size;
+    if (data_lo < offset + size + mdat_hdr || data_hi > frag->end)
+        return AVERROR_INVALIDDATA;
+
+    for (int i = 0; i < c->fc->nb_streams; i++)
+        ends[i] = AV_NOPTS_VALUE;
+    for (int i = 0; i < nb_trafs; i++)
+        ends[traf_stream[i]] = FFMAX(ends[traf_stream[i]], traf_end[i]);
+    return 0;
+}
+
+/* The track ends of a parsed moof count once the fragment is accepted: a candidate
+ * found by resynchronising may still be dropped, and its times are then sample data. */
+static void mov_lazy_take_ends(MOVContext *c, const int64_t *ends)
+{
+    for (int i = 0; i < c->fc->nb_streams; i++)
+        if (ends[i] != AV_NOPTS_VALUE)
+            c->lazy_track_end[i] = FFMAX(c->lazy_track_end[i], ends[i]);
+}
+
+/* A sidx passed over on the way: mov_read_sidx() makes the end of what it describes
+ * the duration of its track, so a file with a sidx per fragment gets its duration
+ * from the last one. Note that end, as stored there (in the sidx's own time scale). */
+static void mov_lazy_sidx_end(MOVContext *c, const uint8_t *buf, int len)
+{
+    int version, count, p;
+    int64_t end;
+    unsigned id;
+
+    if (len < 32 || (version = buf[8]) > 1)
+        return;
+    id  = AV_RB32(buf + 12);
+    end = version ? AV_RB64(buf + 20) : AV_RB32(buf + 20);
+    p   = version ? 36 : 28;
+    if (len < p + 4)
+        return;
+    count = AV_RB16(buf + p + 2);
+    p += 4;
+    if (len < p + 12 * count)
+        return;
+    for (int i = 0; i < count; i++)
+        end += AV_RB32(buf + p + 12 * i + 4);
+    for (int i = 0; i < c->fc->nb_streams; i++)
+        if (((MOVStreamContext *)c->fc->streams[i]->priv_data)->id == id)
+            c->lazy_sidx_end[i] = FFMAX(c->lazy_sidx_end[i], end);
+}
+
+/**
+ * The box chain puts a top-level box at pos. Find the fragment that starts there,
+ * stepping over the boxes that may sit between fragments.
+ *
+ * @return its index, MOV_LAZY_END when the media ends there, MOV_LAZY_INVALID when
+ *         what is there cannot be followed, or a negative AVERROR
+ */
+static int mov_lazy_chain(MOVContext *c, AVIOContext *pb, int64_t pos)
+{
+    uint8_t buf[MOV_LAZY_PROBE];
+
+    for (int n = 0; n < 256; n++) {
+        int64_t left = c->lazy_size - pos, size;
+        uint32_t type;
+        int index = mov_lazy_find(c, pos), len;
+
+        if (index < c->nb_lazy_frags && c->lazy_frags[index].offset == pos)
+            return index;
+        if (!left || pos == c->lazy_media_end)
+            return MOV_LAZY_END;
+        if (left < 8)
+            return MOV_LAZY_INVALID;
+        len = mov_lazy_read(pb, pos, buf, FFMIN(sizeof(buf), left));
+        if (len < 8)
+            return MOV_LAZY_INVALID;
+        size = AV_RB32(buf);
+        type = AV_RL32(buf + 4);
+        if (type == MKTAG('m','o','o','f')) {
+            MOVLazyFrag frag;
+            int ret = mov_lazy_parse_moof(c, buf, len, pos, &frag, c->lazy_chain_end);
+            if (ret == AVERROR(EAGAIN)) {
+                int need = FFMIN(size + 16, left);
+                uint8_t *big = av_malloc(need);
+                if (!big)
+                    return AVERROR(ENOMEM);
+                ret = mov_lazy_read(pb, pos, big, need) == need ?
+                      mov_lazy_parse_moof(c, big, need, pos, &frag, c->lazy_chain_end) :
+                      AVERROR_INVALIDDATA;
+                av_free(big);
+            }
+            if (ret < 0)
+                return MOV_LAZY_INVALID;
+            mov_lazy_take_ends(c, c->lazy_chain_end);
+            return mov_lazy_add(c, &frag);
+        }
+        if (size == 1) {
+            if (len < 16)
+                return MOV_LAZY_INVALID;
+            size = AV_RB64(buf + 8);
+        } else if (!size) {
+            size = left;
+        }
+        if (size < 8 || size > left)
+            return MOV_LAZY_INVALID;
+        switch (type) {
+        case MKTAG('s','i','d','x'):
+            mov_lazy_sidx_end(c, buf, FFMIN(len, size));
+        case MKTAG('s','s','i','x'):
+        case MKTAG('s','t','y','p'): case MKTAG('p','r','f','t'):
+        case MKTAG('e','m','s','g'): case MKTAG('f','r','e','e'):
+        case MKTAG('s','k','i','p'): case MKTAG('u','u','i','d'):
+        case MKTAG('m','d','a','t'):
+            pos += size;
+            break;
+        case MKTAG('m','f','r','a'): case MKTAG('m','e','t','a'):
+        case MKTAG('u','d','t','a'):
+            return MOV_LAZY_END;
+        default:
+            return MOV_LAZY_INVALID;
+        }
+    }
+    return MOV_LAZY_INVALID;
+}
+
+/** The fragment after the one at offset, as mov_lazy_chain() returns it. */
+static int mov_lazy_next(MOVContext *c, AVIOContext *pb, int64_t offset)
+{
+    int index = mov_lazy_find(c, offset), ret;
+    int64_t end;
+
+    if (index >= c->nb_lazy_frags || c->lazy_frags[index].offset != offset)
+        return MOV_LAZY_INVALID;
+    if (c->lazy_frags[index].next > 0)
+        return mov_lazy_find(c, c->lazy_frags[index].next);
+    if (c->lazy_frags[index].next < 0)
+        return c->lazy_frags[index].next;
+    end = c->lazy_frags[index].end;
+    ret = mov_lazy_chain(c, pb, end);
+    if (ret < MOV_LAZY_INVALID)
+        return ret;
+    index = mov_lazy_find(c, offset);
+    c->lazy_frags[index].next = ret >= 0 ? c->lazy_frags[ret].offset : ret;
+    return ret;
+}
+
+/**
+ * Resynchronise: the first fragment that starts at or after from and before limit.
+ * A candidate counts once it parses and the box chain behind it holds.
+ *
+ * @return its index, MOV_LAZY_END when no fragment starts in that range, or a
+ *         negative AVERROR
+ */
+static int mov_lazy_scan(MOVContext *c, AVIOContext *pb, int64_t from, int64_t limit)
+{
+    uint8_t *buf = NULL;
+    unsigned allocated = 0;
+    int64_t base = from, rp = from;
+    int len = 0, pos = 4, eof = 0, ret = MOV_LAZY_END;
+
+#define MOV_LAZY_FILL(want) do {                                              \
+        int n_;                                                               \
+        uint8_t *nb_ = av_fast_realloc(buf, &allocated, len + (want));        \
+        if (!nb_) { ret = AVERROR(ENOMEM); goto end; }                        \
+        buf = nb_;                                                            \
+        if (avio_tell(pb) != rp && avio_seek(pb, rp, SEEK_SET) < 0) n_ = 0;   \
+        else n_ = avio_read(pb, buf + len, (want));                           \
+        if (n_ <= 0) eof = 1;                                                 \
+        else { len += n_; rp += n_; }                                         \
+    } while (0)
+
+    while (1) {
+        int found = -1, cand;
+        int64_t coff, size;
+
+        for (int i = pos; i + 4 <= len; i++)
+            if (buf[i] == 'm' && AV_RL32(buf + i) == MKTAG('m','o','o','f')) {
+                found = i;
+                break;
+            }
+        if (found < 0) {
+            int keep = FFMIN(len, 7);
+            if (eof || base + len >= limit + 8)
+                break;
+            memmove(buf, buf + len - keep, keep);
+            base += len - keep;
+            len   = keep;
+            pos   = 4;
+            MOV_LAZY_FILL(MOV_LAZY_CHUNK);
+            continue;
+        }
+        cand = found - 4;
+        coff = base + cand;
+        if (coff >= limit)
+            break;
+        size = AV_RB32(buf + cand);
+        if (size >= 8 + 16 + 8 + 16 && size <= MOV_LAZY_MAX_MOOF &&
+            size + 8 <= c->lazy_size - coff) {
+            int64_t need = FFMIN(size + 16, c->lazy_size - coff);
+            MOVLazyFrag frag;
+
+            while (len - cand < need && !eof)
+                MOV_LAZY_FILL(FFMAX(need - (len - cand), MOV_LAZY_CHUNK));
+            if (len - cand >= need &&
+                !mov_lazy_parse_moof(c, buf + cand, len - cand, coff, &frag, c->lazy_scan_end)) {
+                int index = mov_lazy_add(c, &frag);
+                if (index < 0) {
+                    ret = index;
+                    goto end;
+                }
+                ret = mov_lazy_next(c, pb, coff);
+                if (ret < MOV_LAZY_INVALID)
+                    goto end;
+                if (ret != MOV_LAZY_INVALID) {
+                    mov_lazy_take_ends(c, c->lazy_scan_end);
+                    ret = mov_lazy_find(c, coff);
+                    goto end;
+                }
+                mov_lazy_remove(c, coff);
+                ret = MOV_LAZY_END;
+            }
+        }
+        pos = found + 1;
+    }
+end:
+    av_free(buf);
+    return ret;
+}
+
+/* Probe the fragment an mfra entry points at; the mfra is dropped if it lies. */
+static int mov_lazy_hint(MOVContext *c, AVIOContext *pb, int i)
+{
+    int ret = mov_lazy_chain(c, pb, c->lazy_hints[i].offset);
+
+    if (ret == MOV_LAZY_INVALID || ret == MOV_LAZY_END ||
+        (ret >= 0 && c->lazy_frags[ret].offset != c->lazy_hints[i].offset)) {
+        c->nb_lazy_hints = 0;
+        return MOV_LAZY_INVALID;
+    }
+    return ret;
+}
+
+/**
+ * Find the fragment of the reference track that holds decode time t (reference
+ * track time scale, as in tfdt): the last one starting at or before t.
+ *
+ * @return its index, or a negative AVERROR
+ */
+static int mov_lazy_resolve(MOVContext *c, AVIOContext *pb, int64_t t)
+{
+    int64_t lo = -1, hi_limit = c->lazy_size, hi_time = AV_NOPTS_VALUE;
+    int halved = 1, index, ret;
+
+    /* An mfra says where the fragments are and roughly when; go straight there. */
+    if (c->nb_lazy_hints) {
+        int a = 0, b = c->nb_lazy_hints;
+        while (a < b) {
+            int m = (a + b) >> 1;
+            if (c->lazy_hints[m].time <= t)
+                a = m + 1;
+            else
+                b = m;
+        }
+        for (a = FFMAX(a - 1, 0); a >= 0 && c->nb_lazy_hints; a--) {
+            ret = mov_lazy_hint(c, pb, a);
+            if (ret < MOV_LAZY_INVALID)
+                return ret;
+            if (ret < 0 || !c->lazy_frags[ret].has_ref || c->lazy_frags[ret].time <= t)
+                break;
+        }
+    }
+
+    for (int i = 0; i < c->nb_lazy_frags; i++) {
+        const MOVLazyFrag *f = &c->lazy_frags[i];
+        if (!f->has_ref)
+            continue;
+        if (f->time <= t) {
+            lo = f->offset;
+        } else {
+            if (lo < 0)             /* before the first fragment: that one it is */
+                return i;
+            hi_limit = f->offset;
+            hi_time  = f->time;
+            break;
+        }
+    }
+    if (lo < 0)
+        return AVERROR_INVALIDDATA;
+
+    for (int step = 0; step < 1000; step++) {
+        const MOVLazyFrag *l = &c->lazy_frags[mov_lazy_find(c, lo)];
+        int64_t low = l->end, guess, before = hi_limit - low, fdur, ht, first;
+        int scanned, near;
+
+        if (t < l->time_end || low >= hi_limit)
+            break;
+        fdur = FFMAX(c->lazy_dur_sum / FFMAX(c->lazy_dur_count, 1), 1);
+        ht   = hi_time != AV_NOPTS_VALUE ? hi_time :
+               FFMAX(c->lazy_track_end[c->lazy_ref_stream], t + fdur);
+        near = t - l->time_end <= 2 * fdur || before <= 2 * MOV_LAZY_PROBE;
+        if (near)
+            guess = low;
+        else if (halved)            /* interpolate, aiming a fragment and a half early */
+            guess = low + (int64_t)((double)(t - l->time_end - fdur - fdur / 2) * before /
+                                    FFMAX(ht - l->time_end, 1));
+        else                        /* interpolation is not converging: bisect */
+            guess = low + before / 2;
+        guess   = FFMIN(guess, hi_limit - 1);
+        scanned = guess > low + MOV_LAZY_PROBE;
+
+        if (!scanned) {
+            ret = mov_lazy_next(c, pb, lo);
+        } else if (c->nb_lazy_hints) {
+            int a = 0, b = c->nb_lazy_hints;
+            while (a < b) {
+                int m = (a + b) >> 1;
+                if (c->lazy_hints[m].offset < guess)
+                    a = m + 1;
+                else
+                    b = m;
+            }
+            if (a < c->nb_lazy_hints && c->lazy_hints[a].offset < hi_limit) {
+                ret = mov_lazy_hint(c, pb, a);
+                if (ret == MOV_LAZY_INVALID)
+                    continue;       /* the mfra is gone, resynchronise instead */
+            } else {
+                ret = MOV_LAZY_END;
+            }
+        } else {
+            ret = mov_lazy_scan(c, pb, guess, hi_limit);
+        }
+        if (ret < MOV_LAZY_INVALID)
+            return ret;
+        if (ret < 0 && !scanned)
+            break;                  /* the media ends after lo */
+        first = ret >= 0 ? c->lazy_frags[ret].offset : -1;
+        /* A fragment without the reference track decides nothing; the next one does. */
+        while (ret >= 0 && !c->lazy_frags[ret].has_ref)
+            ret = mov_lazy_next(c, pb, c->lazy_frags[ret].offset);
+        if (ret < MOV_LAZY_INVALID)
+            return ret;
+        if (ret >= 0 && c->lazy_frags[ret].time <= t) {
+            lo = c->lazy_frags[ret].offset;
+        } else {
+            /* A scan from guess shows that no fragment starts between guess and
+             * the one it found. */
+            hi_limit = scanned ? guess : low;
+            hi_time  = ret >= 0 ? c->lazy_frags[ret].time : AV_NOPTS_VALUE;
+            if (ret < 0 && first < 0)
+                halved = 0;
+        }
+        l = &c->lazy_frags[mov_lazy_find(c, lo)];
+        if (hi_limit - l->end > before / 2)
+            halved = 0;
+        else
+            halved = 1;
+    }
+    /* What follows lo must start after t. An mfra that leaves fragments out, or a
+     * hole in the timeline, shows here. */
+    for (int n = 0;; n++) {
+        if (t < c->lazy_frags[mov_lazy_find(c, lo)].time_end)
+            break;
+        ret = mov_lazy_next(c, pb, lo);
+        while (ret >= 0 && !c->lazy_frags[ret].has_ref)
+            ret = mov_lazy_next(c, pb, c->lazy_frags[ret].offset);
+        if (ret < MOV_LAZY_INVALID)
+            return ret;
+        if (ret < 0 || c->lazy_frags[ret].time > t)
+            break;
+        lo = c->lazy_frags[ret].offset;
+        if (n == 4 && c->nb_lazy_hints) {
+            c->nb_lazy_hints = 0;
+            return mov_lazy_resolve(c, pb, t);
+        }
+    }
+    index = mov_lazy_find(c, lo);
+    return index;
+}
 
+/**
+ * The reference-track fragment before the one at offset.
+ *
+ * @param resync when 0, only what is known without reading sample data
+ * @return its offset, -1 when there is none or it is not known, or a negative AVERROR
+ */
+static int64_t mov_lazy_prev(MOVContext *c, AVIOContext *pb, int64_t offset, int resync)
+{
+    int64_t back = 4 * MOV_LAZY_CHUNK;
+
+    if (offset <= c->lazy_first)
+        return -1;
+    for (int pass = 0; pass < 16; pass++) {
+        int64_t found = -1, from;
+        int index = mov_lazy_find(c, offset), ret;
+
+        /* walk the known chain back from offset */
+        while (index > 0 && c->lazy_frags[index - 1].next == c->lazy_frags[index].offset) {
+            index--;
+            if (c->lazy_frags[index].has_ref) {
+                found = c->lazy_frags[index].offset;
+                break;
+            }
+        }
+        if (found >= 0)
+            return found;
+        from = c->lazy_frags[index].offset;     /* earliest fragment chained to offset */
+        if (from <= c->lazy_first)
+            return -1;
+
+        if (c->nb_lazy_hints) {
+            int a = 0, b = c->nb_lazy_hints;
+            while (a < b) {
+                int m = (a + b) >> 1;
+                if (c->lazy_hints[m].offset < from)
+                    a = m + 1;
+                else
+                    b = m;
+            }
+            ret = a > 0 ? mov_lazy_hint(c, pb, a - 1) : MOV_LAZY_END;
+        } else if (!resync) {
+            return -1;
+        } else {
+            int64_t start = FFMAX(from - back, c->lazy_first);
+            ret = start <= c->lazy_first ? mov_lazy_find(c, c->lazy_first) :
+                                           mov_lazy_scan(c, pb, start, from);
+            back *= 4;
+        }
+        if (ret < MOV_LAZY_INVALID)
+            return ret;
+        /* chain forward from what was found until it meets the fragment at from */
+        for (int n = 0; ret >= 0 && n < 4096 && c->lazy_frags[ret].offset < from; n++)
+            ret = mov_lazy_next(c, pb, c->lazy_frags[ret].offset);
+        if (ret < MOV_LAZY_INVALID)
+            return ret;
+        if (!c->nb_lazy_hints && !resync)
+            return -1;
+    }
+    return -1;
+}
+
+/* Fragment positions from the mfra, when the file has one. Only used as hints:
+ * each is checked against the moof it points at before it counts. */
+static int mov_lazy_read_mfra(MOVContext *c, AVIOContext *pb, int64_t *tail, int before_last)
+{
+    uint8_t last[16384], *alloc = NULL;
+    const uint8_t *buf;
+    int64_t size, p;
+    int n = FFMIN(c->lazy_size, sizeof(last));
+    unsigned ref_id = ((MOVStreamContext *)c->fc->streams[c->lazy_ref_stream]->priv_data)->id;
+
+    *tail = INT64_MAX;
+    /* one read for the mfro and, unless it is large, the mfra in front of it */
+    if (n < 16 || mov_lazy_read(pb, c->lazy_size - n, last, n) != n)
+        return 0;
+    size = AV_RB32(last + n - 4);
+    if (AV_RL32(last + n - 12) != MKTAG('m','f','r','o') ||
+        size < 8 + 24 + 16 || size > FFMIN(c->lazy_size, 64 << 20))
+        return 0;
+    if (size <= n) {
+        buf = last + n - size;
+    } else {
+        buf = alloc = av_malloc(size);
+        if (!alloc)
+            return AVERROR(ENOMEM);
+        if (mov_lazy_read(pb, c->lazy_size - size, alloc, size) != size) {
+            av_free(alloc);
+            return 0;
+        }
+    }
+    if (AV_RB32(buf) != size || AV_RL32(buf + 4) != MKTAG('m','f','r','a')) {
+        av_free(alloc);
+        return 0;
+    }
+    c->lazy_media_end = c->lazy_size - size;
+    for (p = 8; size - p >= 8;) {
+        int64_t bs = AV_RB32(buf + p);
+
+        if (bs < 8 || bs > size - p)
+            break;
+        if (AV_RL32(buf + p + 4) == MKTAG('t','f','r','a') && bs >= 24) {
+            const uint8_t *e = buf + p + 24;
+            int version    = buf[p + 8];
+            unsigned track = AV_RB32(buf + p + 12), fl = AV_RB32(buf + p + 16);
+            int64_t n      = AV_RB32(buf + p + 20), last = -1, last2 = -1;
+            int es = (version ? 16 : 8) + ((fl >> 4) & 3) + ((fl >> 2) & 3) + (fl & 3) + 3;
+            MOVLazyHint *hints = NULL;
+
+            if ((bs - 24) / es < n)
+                break;
+            if (track == ref_id && !c->lazy_hints && n) {
+                hints = av_malloc_array(n, sizeof(*hints));
+                if (!hints) {
+                    av_free(alloc);
+                    return AVERROR(ENOMEM);
+                }
+            }
+            for (int64_t i = 0; i < n; i++, e += es) {
+                int64_t time   = version ? AV_RB64(e)     : AV_RB32(e);
+                int64_t offset = version ? AV_RB64(e + 8) : AV_RB32(e + 4);
+                /* entries are in time order; keep the ones that also advance in the file */
+                if (offset <= last || offset >= c->lazy_size)
+                    continue;
+                last2 = last;
+                last  = offset;
+                if (hints) {
+                    hints[c->nb_lazy_hints].time     = time;
+                    hints[c->nb_lazy_hints++].offset = offset;
+                }
+            }
+            if (hints)
+                c->lazy_hints = hints;
+            /* A sidx in front of the last fragment is only passed when the walk
+             * to the end starts one fragment earlier. */
+            if (before_last && last2 >= 0)
+                last = last2;
+            if (last >= 0)
+                *tail = FFMIN(*tail, last);
+        }
+        p += bs;
+    }
+    av_free(alloc);
+    return 0;
+}
+
+/* Whether every audio and video stream has a fragment among those parsed since
+ * the ends in before were noted. */
+static int mov_lazy_tail_covers(const MOVContext *c, const int64_t *before)
+{
+    for (int i = 0; i < c->fc->nb_streams; i++) {
+        const AVStream *st = c->fc->streams[i];
+        if ((st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO ||
+             st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO) &&
+            !(st->disposition & AV_DISPOSITION_ATTACHED_PIC) &&
+            c->lazy_track_end[i] == before[i])
+            return 0;
+    }
+    return 1;
+}
+
+/* Follow the chain from offset to the end of the media. */
+static int mov_lazy_walk_to_end(MOVContext *c, AVIOContext *pb, int64_t offset)
+{
+    int ret = mov_lazy_chain(c, pb, offset);
+
+    for (int n = 0; ret >= 0 && n < 65536; n++)
+        ret = mov_lazy_next(c, pb, c->lazy_frags[ret].offset);
     return ret;
+}
+
+/**
+ * Decide, once the first moof has been read, whether this file can be indexed
+ * lazily: its fragments must carry tfdt, and the end of the media must be found
+ * (through the mfra, or by resynchronising near the end of the file) so that the
+ * streams get the duration a full scan would have given them.
+ */
+static void mov_lazy_init(MOVContext *c, AVIOContext *pb)
+{
+    int64_t pos = avio_tell(pb), tail = INT64_MAX, *before = NULL;
+    int ret, has_sidx = 0;
+
+    c->lazy_state = -1;
+    c->lazy_size  = c->lazy_media_end = avio_size(pb);
+    if (c->lazy_size <= 0 || !c->fc->nb_streams)
+        return;
+    c->lazy_ref_stream = 0;
+    for (int i = 0; i < c->fc->nb_streams; i++) {
+        const AVStream *st = c->fc->streams[i];
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
+            !(st->disposition & AV_DISPOSITION_ATTACHED_PIC)) {
+            c->lazy_ref_stream = i;
+            break;
+        }
+    }
+    c->lazy_track_end = av_malloc_array(c->fc->nb_streams, 4 * sizeof(*c->lazy_track_end));
+    if (!c->lazy_track_end)
+        return;
+    c->lazy_sidx_end  = c->lazy_track_end + c->fc->nb_streams;
+    c->lazy_chain_end = c->lazy_track_end + 2 * c->fc->nb_streams;
+    c->lazy_scan_end  = c->lazy_track_end + 3 * c->fc->nb_streams;
+    for (int i = 0; i < 2 * c->fc->nb_streams; i++)
+        c->lazy_track_end[i] = AV_NOPTS_VALUE;
+
+    /* the fragment(s) the header has just read */
+    c->lazy_first = c->frag_index.item[0].moof_offset;
+    ret = mov_lazy_chain(c, pb, c->lazy_first);
+    for (int n = 0; ret >= 0 && !c->lazy_frags[ret].has_ref && n < 64; n++)
+        ret = mov_lazy_next(c, pb, c->lazy_frags[ret].offset);
+    if (ret < 0 || !c->lazy_frags[ret].has_ref)
+        goto end;
+    c->lazy_first = c->lazy_frags[ret].offset;
+
+    /* The end of the media, and with it the duration of every stream: the last
+     * fragment of each audio and video track has to be among those found. */
+    before = av_memdup(c->lazy_track_end, c->fc->nb_streams * sizeof(*before));
+    for (int i = 0; i < c->fc->nb_streams; i++)
+        has_sidx |= ((MOVStreamContext *)c->fc->streams[i]->priv_data)->has_sidx;
+    if (!before || mov_lazy_read_mfra(c, pb, &tail, has_sidx) < 0)
+        goto end;
+    ret = MOV_LAZY_INVALID;
+    if (tail != INT64_MAX)
+        ret = mov_lazy_walk_to_end(c, pb, tail);
+    if (ret != MOV_LAZY_END || !mov_lazy_tail_covers(c, before)) {
+        int64_t limit = c->lazy_media_end, first_end = c->lazy_frags[mov_lazy_find(c, c->lazy_first)].end;
+
+        if (ret != MOV_LAZY_END) {          /* the mfra does not lead to fragments */
+            av_freep(&c->lazy_hints);
+            c->nb_lazy_hints  = 0;
+            c->lazy_media_end = limit = c->lazy_size;
+        }
+        ret = MOV_LAZY_INVALID;
+        for (int64_t window = 4 * MOV_LAZY_CHUNK; window <= (64 << 20); window *= 4) {
+            int64_t from = FFMAX(c->lazy_size - window, first_end);
+            int found = from < limit ? mov_lazy_scan(c, pb, from, limit) : MOV_LAZY_END;
+
