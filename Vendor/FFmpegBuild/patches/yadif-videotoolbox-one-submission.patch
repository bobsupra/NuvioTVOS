+// n8.1.3's YADIFContext.filter returns void (master propagates the error since
+// 2b99c068db), so a failed frame still goes out; filter_planes() has logged it.
+// It gets the attachments and field state a successful frame would have.
+static void filter(AVFilterContext *ctx, AVFrame *dst,
+                   int parity, int tff) API_AVAILABLE(macos(10.11), ios(8.3))
+{
+    YADIFVTContext *s = ctx->priv;
+    YADIFContext *y = &s->yadif;
+
+    CVPixelBufferRef dst_buf = (CVPixelBufferRef)dst->data[3];
+
+    if (filter_planes(ctx, dst, parity, tff) >= 0)
+        return;
+
+    CVBufferRemoveAllAttachments(dst_buf);
+    CVBufferPropagateAttachments((CVPixelBufferRef)y->cur->data[3], dst_buf);
+    CVBufferRemoveAttachment(dst_buf, kCVImageBufferFieldCountKey);
+    CVBufferRemoveAttachment(dst_buf, kCVImageBufferFieldDetailKey);
+    CVBufferRemoveAttachment(dst_buf, kCVImageBufferChromaLocationBottomFieldKey);
+    if (y->current_field == YADIF_FIELD_END)
+        y->current_field = YADIF_FIELD_NORMAL;
+}
